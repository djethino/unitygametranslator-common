{
  "rule": "line_writes",
  "classes": ["LineWrites"],
  "note": "What a writer owes a file before a line is written (draft §6). The answer is the CODE of the first reason, null when the line may be written; the reason in words is in the C# (LineWrites) and its sentences are not frozen — what is frozen is which rule fires first. `entries` are the lines of the file, `lists` the names `_lists` holds.",
  "operations": {
    "refusal": {"in": {"key": "string", "line": "a line in the file's form, format 2 fields included", "file_format": "int", "entries": "{key: line}", "lists": "[list names]", "by_machine": "bool", "previous": "a line or null"}, "out": "the refusal code or null"}
  },
  "cases": [
    { "id": "line_writes/refusal/plain-line", "op": "refusal",
      "in": {"key": "Play", "line": {"v": "Jouer", "t": "A"}, "file_format": 2, "entries": {"Star Coin": {"v": "Pièce d'étoile", "t": "V", "term": true, "forms": {"1": "pièces d'étoile"}}}, "lists": [], "by_machine": false, "previous": null},
      "out": null,
      "why": "a line with no field of the format 2 is asked nothing" },
    { "id": "line_writes/refusal/well-formed-link", "op": "refusal",
      "in": {"key": "Not enough Star Coins!", "line": {"v": "Pas assez de [!g*0] !", "t": "A", "links": [{"to": "Star Coin", "form": "1", "by": "A", "was": "pièces d'étoile"}]}, "file_format": 2, "entries": {"Star Coin": {"v": "Pièce d'étoile", "t": "V", "term": true, "forms": {"1": "pièces d'étoile"}}}, "lists": [], "by_machine": false, "previous": null},
      "out": null,
      "why": "marker, link, entry and form all there" },
