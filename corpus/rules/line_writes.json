      "out": "format-2-field-in-format-1",
      "why": "a field of the format 2 in a file that says format 1" },
    { "id": "line_writes/refusal/format-0-is-format-1", "op": "refusal",
      "in": {"key": "Star Coin", "line": {"v": "Pièce", "t": "V", "term": true}, "file_format": 0, "entries": {"Star Coin": {"v": "Pièce d'étoile", "t": "V", "term": true, "forms": {"1": "pièces d'étoile"}}}, "lists": [], "by_machine": false, "previous": null},
      "out": "format-2-field-in-format-1",
