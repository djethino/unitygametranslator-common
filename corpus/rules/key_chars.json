{
  "rule": "key_chars",
  "classes": ["KeyChars"],
  "note": "The two character facts the key needs, from Unicode (KeyChars.Tables.g.cs, tools/generate-key-chars.py, the project's pinned version): which UTF-16 units are decimal digits (Nd, Basic Multilingual Plane) and which are white space (White_Space, same plane). Measured equal, on .NET 8.0.34, to the runtime's `\\d` (370) and Trim() (25).",
  "operations": {
    "is_digit": {"in": {"code_unit": "int"}, "out": "bool"},
    "is_space": {"in": {"code_unit": "int"}, "out": "bool"},
    "trim": {"in": {"text": "string or null"}, "out": "the text without the white space at its ends"}
  },
  "cases": [
    { "id": "key_chars/is_digit/ascii-five", "op": "is_digit",
      "in": {"code_unit": 53},
      "out": true,
      "why": "an ASCII digit" },
    { "id": "key_chars/is_digit/arabic-indic-zero", "op": "is_digit",
      "in": {"code_unit": 1632},
      "out": true,
      "why": "the first digit that is not ASCII" },
    { "id": "key_chars/is_digit/fullwidth-one", "op": "is_digit",
      "in": {"code_unit": 65297},
      "out": true,
      "why": "a fullwidth digit" },
    { "id": "key_chars/is_digit/devanagari", "op": "is_digit",
      "in": {"code_unit": 2406},
      "out": true,
      "why": "a digit of another script" },
    { "id": "key_chars/is_digit/circled-one-is-no-decimal-digit", "op": "is_digit",
      "in": {"code_unit": 9312},
      "out": false,
      "why": "Nd only: a circled digit is a number-like symbol, not a decimal digit" },
    { "id": "key_chars/is_digit/arabic-decimal-separator", "op": "is_digit",
      "in": {"code_unit": 1643},
      "out": false,
      "why": "a mark of the script is no digit" },
    { "id": "key_chars/is_digit/letter", "op": "is_digit",
      "in": {"code_unit": 97},
      "out": false,
      "why": "a letter" },
    { "id": "key_chars/is_digit/a-surrogate", "op": "is_digit",
      "in": {"code_unit": 55349},
      "out": false,
      "why": "a unit of a surrogate pair: the key reads by UTF-16 unit, so a digit outside the plane is no digit" },
    { "id": "key_chars/is_digit/just-before-the-first-non-ascii-digit", "op": "is_digit",
      "in": {"code_unit": 1631},
      "out": false,
      "why": "the boundary of the shortcut for ASCII" },
    { "id": "key_chars/is_space/space", "op": "is_space",
      "in": {"code_unit": 32},
      "out": true,
      "why": "White_Space" },
    { "id": "key_chars/is_space/tab", "op": "is_space",
      "in": {"code_unit": 9},
      "out": true,
      "why": "and the controls Unicode counts as space (9 to 13)" },
    { "id": "key_chars/is_space/next-line", "op": "is_space",
      "in": {"code_unit": 133},
      "out": true,
      "why": "U+0085" },
    { "id": "key_chars/is_space/no-break-space", "op": "is_space",
      "in": {"code_unit": 160},
      "out": true,
      "why": "the no-break space" },
    { "id": "key_chars/is_space/em-space", "op": "is_space",
      "in": {"code_unit": 8195},
      "out": true,
      "why": "a typographic space" },
    { "id": "key_chars/is_space/line-separator", "op": "is_space",
      "in": {"code_unit": 8232},
      "out": true,
      "why": "U+2028 and U+2029 are white space" },
    { "id": "key_chars/is_space/ideographic-space", "op": "is_space",
      "in": {"code_unit": 12288},
      "out": true,
      "why": "the ideographic space" },
    { "id": "key_chars/is_space/zero-width-space", "op": "is_space",
      "in": {"code_unit": 8203},
      "out": false,
      "why": "not White_Space" },
    { "id": "key_chars/is_space/mongolian-vowel-separator", "op": "is_space",
      "in": {"code_unit": 6158},
      "out": false,
      "why": "not any more" },
    { "id": "key_chars/is_space/information-separator-four", "op": "is_space",
      "in": {"code_unit": 28},
      "out": false,
      "why": "a control, not White_Space (Java counts it, Unicode does not)" },
    { "id": "key_chars/is_space/letter", "op": "is_space",
      "in": {"code_unit": 97},
      "out": false,
      "why": "a letter" },
    { "id": "key_chars/trim/both-ends", "op": "trim",
      "in": {"text": " \t x y 　"},
      "out": "x y",
      "why": "both ends, never the inside" },
    { "id": "key_chars/trim/nothing-to-do", "op": "trim",
      "in": {"text": "x"},
      "out": "x",
      "why": "the same string" },
    { "id": "key_chars/trim/only-spaces", "op": "trim",
      "in": {"text": "   "},
      "out": "",
      "why": "nothing left" },
    { "id": "key_chars/trim/empty", "op": "trim",
      "in": {"text": ""},
      "out": "",
      "why": "nothing" },
    { "id": "key_chars/trim/null", "op": "trim",
      "in": {"text": null},
      "out": null,
      "why": "no text" }
  ]
}
