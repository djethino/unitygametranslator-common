{
 "rule": "unicode_categories",
 "classes": [
  "UnicodeCategories"
 ],
 "note": "The general category of every code point, from the project's Unicode (UnicodeCategories.Tables.g.cs, tools/generate-general-category.py, UNICODE_VERSION): all planes, never the runtime's \u2014 .NET 8.0.34 did not know 22 068 letters Unicode 18 does (27 in the Basic Multilingual Plane). The expected answers were read from UnicodeData.txt, not from the code. A code point nobody assigned, a lone surrogate and a value out of range are Cn.",
 "operations": {
  "of": {
   "in": {
    "code_point": "int"
   },
   "out": "the two-letter category, Cn when none"
  },
  "of_in_text": {
   "in": {
    "text": "string",
    "index": "int, a UTF-16 index"
   },
   "out": "the category of the code point starting there (a surrogate pair read whole)"
  },
  "is_letter": {
   "in": {
    "code_point": "int"
   },
   "out": "bool: L*"
  },
  "is_mark": {
   "in": {
    "code_point": "int"
   },
   "out": "bool: M*"
  },
  "is_number": {
   "in": {
    "code_point": "int"
   },
   "out": "bool: N*"
  },
  "is_letter_or_digit": {
   "in": {
    "code_point": "int"
   },
   "out": "bool: L* or Nd"
  }
 },
