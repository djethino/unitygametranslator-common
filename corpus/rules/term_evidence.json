    { "id": "term_evidence/of/a-single-line-names-the-term", "op": "of",
      "in": { "term": "Lone", "lines": [
          {"key": "Lone Gate", "line": {"v": "Portail unique", "t": "V"}},
          {"key": "Plain Gate", "line": {"v": "Portail simple", "t": "V"}},
          {"key": "Plain Key", "line": {"v": "Cle simple", "t": "V"}} ] },
      "out": { "verdict": "thin", "word": null, "keys": [], "rivals": [] },
      "why": "at one line the candidate would be the line itself: it takes two" },
    { "id": "term_evidence/of/two-spellings-of-a-word-are-no-candidate", "op": "of",
      "in": { "term": "Open", "lines": [
          {"key": "Open Door", "line": {"v": "Porte ouvert", "t": "V"}},
