{
  "rule": "term_evidence",
  "classes": ["TermEvidence"],
  "note": "How a person's own lines (H or V, with words) write a term, found with no cutting of a text into words. `of`: a term (its source form) and the validated lines of the WHOLE file (key, line) → the verdict, the writing and its keys, the rivals (the contradiction). `of_all`: the same for every term, with the guard that two terms receiving the very same writing are both `ambiguous`. A candidate is a stretch of 2 to 24 characters, no white space at its ends, held (at word edges, first letter in either case) by at least 2 lines whose KEY holds the term, and CONFINED: at least half of the lines of the whole file that hold it are such lines; the lines that hold the same stretches are one writing, the longest speaks for it, spelled the way most of its lines spell it. The writing held by the most lines wins; at the same count the one with more lines by hand (H); at the same again, `tied`. The rival is the same search among the lines of the term that do not carry the winner. Every line is invented: no text of a game is in a case. Expected values are derived by hand from the rule, never from the code.",
  "operations": {
    "of": { "in": { "term": "string", "lines": "list of {key, line}" }, "out": "{verdict: none|thin|word|tied|ambiguous, word, keys, rivals: [{words, keys}]}" },
    "of_all": { "in": { "terms": "list of string", "lines": "list of {key, line}" }, "out": "list of {term, verdict, word}: `ambiguous` for every term whose writing another term receives too" }
  },
  "cases": [
    { "id": "term_evidence/of/no-line-names-the-term", "op": "of",
      "in": { "term": "Zorb", "lines": [ {"key": "Play", "line": {"v": "Jouer", "t": "V"}} ] },
      "out": { "verdict": "none", "word": null, "keys": [], "rivals": [] },
      "why": "nothing to read: the question stays as it is" },
    { "id": "term_evidence/of/a-single-line-is-thin", "op": "of",
      "in": { "term": "Speed", "lines": [ {"key": "Top Speed", "line": {"v": "Vitesse max", "t": "V"}} ] },
      "out": { "verdict": "thin", "word": null, "keys": [], "rivals": [] },
      "why": "one line says nothing about which of its words is the term's: at least two lines must hold a writing" },
    { "id": "term_evidence/of/two-lines-with-no-word-in-common-are-thin", "op": "of",
      "in": { "term": "Available", "lines": [ {"key": "Not Available", "line": {"v": "Indisponible", "t": "V"}}, {"key": "Available Now", "line": {"v": "Maintenant", "t": "V"}} ] },
      "out": { "verdict": "thin", "word": null, "keys": [], "rivals": [] },
      "why": "two lines, and no writing held by both" },
    { "id": "term_evidence/of/a-word-all-the-lines-carry", "op": "of",
      "in": { "term": "Wheel", "lines": [
          {"key": "Big Wheel", "line": {"v": "Grande roue", "t": "V"}},
          {"key": "Wheel Lock", "line": {"v": "Verrou de roue", "t": "V"}},
          {"key": "Front Wheel", "line": {"v": "Roue avant", "t": "V"}},
          {"key": "Play", "line": {"v": "Jouer", "t": "V"}},
          {"key": "Quit", "line": {"v": "Quitter", "t": "V"}} ] },
      "out": { "verdict": "word", "word": "roue", "keys": ["Big Wheel", "Wheel Lock", "Front Wheel"], "rivals": [] },
      "why": "the three lines whose key names the term carry « roue », once at the start of a sentence in a capital: one writing, spelled as most of its lines spell it (two lines of three in a small letter); the lines of other keys are not read" },
    { "id": "term_evidence/of/the-contradiction-is-told", "op": "of",
      "in": { "term": "Quest", "lines": [
          {"key": "Quest Log", "line": {"v": "Journal de quête", "t": "V"}},
          {"key": "Main Quest", "line": {"v": "Quête principale", "t": "V"}},
          {"key": "Side Quest", "line": {"v": "Quête annexe", "t": "V"}},
          {"key": "Quest Start", "line": {"v": "Mission lancée", "t": "V"}},
          {"key": "Quest End", "line": {"v": "Mission terminée", "t": "V"}},
          {"key": "Play", "line": {"v": "Jouer", "t": "V"}} ] },
      "out": { "verdict": "word", "word": "Quête", "keys": ["Quest Log", "Main Quest", "Side Quest"],
               "rivals": [ {"words": "Mission", "keys": ["Quest Start", "Quest End"]} ] },
      "why": "3 lines against 2: the most used stays the word, and the other is told with its lines. A person's line is never rewritten to agree. The word is spelled in the case most of its lines start with (two capitals against one small letter)" },
    { "id": "term_evidence/of/a-tie-is-decided-by-the-lines-by-hand", "op": "of",
      "in": { "term": "Tank", "lines": [
          {"key": "Big Tank", "line": {"v": "Grand bac", "t": "H"}},
          {"key": "Small Tank", "line": {"v": "Petit bac", "t": "H"}},
          {"key": "Water Tank", "line": {"v": "Citerne eau", "t": "V"}},
          {"key": "Oil Tank", "line": {"v": "Citerne huile", "t": "V"}} ] },
      "out": { "verdict": "word", "word": "bac", "keys": ["Big Tank", "Small Tank"],
               "rivals": [ {"words": "Citerne", "keys": ["Water Tank", "Oil Tank"]} ] },
      "why": "2 lines each: the one whose lines a person wrote (H) comes before the one a person only read (V); the other is told" },
    { "id": "term_evidence/of/a-tie-nothing-decides", "op": "of",
      "in": { "term": "Tank", "lines": [
          {"key": "Big Tank", "line": {"v": "Grand bac", "t": "V"}},
          {"key": "Small Tank", "line": {"v": "Petit bac", "t": "V"}},
          {"key": "Water Tank", "line": {"v": "Citerne eau", "t": "V"}},
          {"key": "Oil Tank", "line": {"v": "Citerne huile", "t": "V"}} ] },
      "out": { "verdict": "tied", "word": null, "keys": [],
               "rivals": [ {"words": "bac", "keys": ["Big Tank", "Small Tank"]}, {"words": "Citerne", "keys": ["Water Tank", "Oil Tank"]} ] },
      "why": "as many lines, as many by hand: the rule does not decide. The pass's own word is written and marked to read again, by the caller; both writings are told, in the file's order" },
    { "id": "term_evidence/of/a-word-held-everywhere-is-not-the-terms", "op": "of",
      "in": { "term": "Wing", "lines": [
          {"key": "Left Wing", "line": {"v": "Aile gauche avec ressort", "t": "V"}},
          {"key": "Right Wing", "line": {"v": "Aile droite avec cabine", "t": "V"}},
          {"key": "Wing Tip", "line": {"v": "Bout avec pointe", "t": "V"}},
          {"key": "Back", "line": {"v": "Retour avec sauvegarde", "t": "V"}},
          {"key": "Exit", "line": {"v": "Sortie avec confirmation", "t": "V"}},
          {"key": "Load", "line": {"v": "Charger avec choix", "t": "V"}},
          {"key": "Save", "line": {"v": "Garder avec soin", "t": "V"}} ] },
      "out": { "verdict": "word", "word": "Aile", "keys": ["Left Wing", "Right Wing"], "rivals": [] },
      "why": "« avec » is held by all three lines of the term, more lines than « aile », but also by four lines of other keys: fewer than half of its lines belong to the term, so it is not its word (confinement). The third line, alone, is no rival" },
    { "id": "term_evidence/of/a-capital-and-a-small-letter-are-one-word", "op": "of",
      "in": { "term": "Door", "lines": [
          {"key": "Front Door", "line": {"v": "Porte avant", "t": "V"}},
          {"key": "Door Lock", "line": {"v": "Verrou de porte", "t": "V"}} ] },
      "out": { "verdict": "word", "word": "Porte", "keys": ["Front Door", "Door Lock"], "rivals": [] },
      "why": "the first letter is read in either case, as everywhere a writing is looked for: one line has it capitalised and the other not, and each alone would be one line. Spelled the same number of times each way, the first line decides" },
    { "id": "term_evidence/of/a-plural-is-another-word", "op": "of",
      "in": { "term": "Speed", "lines": [
          {"key": "Top Speed", "line": {"v": "Vitesse max", "t": "V"}},
          {"key": "Speed Bar", "line": {"v": "Barre de vitesses", "t": "V"}} ] },
      "out": { "verdict": "thin", "word": null, "keys": [], "rivals": [] },
      "why": "NOT MEASURED and said as it is: « vitesses » is not « vitesse » at word edges, so the agreement of a word is not handled; the forms of the format 2 are the remedy to try" },
    { "id": "term_evidence/of/a-language-with-no-spaces", "op": "of",
      "in": { "term": "Settings", "lines": [
          {"key": "Game Settings", "line": {"v": "ゲーム設定", "t": "V"}},
          {"key": "Sound Settings", "line": {"v": "音声設定", "t": "V"}},
          {"key": "Settings Menu", "line": {"v": "設定メニュー", "t": "V"}},
          {"key": "Play", "line": {"v": "プレイ", "t": "V"}} ] },
      "out": { "verdict": "word", "word": "設定", "keys": ["Game Settings", "Sound Settings", "Settings Menu"], "rivals": [] },
      "why": "no cutting into words and no table of scripts: ideographs and kana do not glue to one another at the edges (WordGlue), so the stretch is found inside the sentences" },
    { "id": "term_evidence/of/lines-that-are-not-validated-are-not-read", "op": "of",
      "in": { "term": "Wheel", "lines": [
          {"key": "Big Wheel", "line": {"v": "Grande roue", "t": "A"}},
          {"key": "Wheel Lock", "line": {"v": "Verrou de roue", "t": "A"}},
          {"key": "Front Wheel", "line": {"v": "", "t": "H"}},
          {"key": "Rear Wheel", "line": {"v": "Roue arrière", "t": "S"}} ] },
      "out": { "verdict": "none", "word": null, "keys": [], "rivals": [] },
      "why": "only what a person wrote or read counts: A is the machine's, an empty H is a capture, S is a refusal with no words" },
    { "id": "term_evidence/of_all/two-terms-the-same-block", "op": "of_all",
      "in": { "terms": ["Summer", "Winter", "Zorb"], "lines": [
          {"key": "Summer Winter Day", "line": {"v": "Cycle Alpha", "t": "V"}},
          {"key": "Summer Winter Night", "line": {"v": "Cycle Beta", "t": "V"}},
          {"key": "Summer Winter Dusk", "line": {"v": "Cycle Gamma", "t": "V"}},
          {"key": "Play", "line": {"v": "Jouer", "t": "V"}} ] },
      "out": [ {"term": "Summer", "verdict": "ambiguous", "word": "Cycle"}, {"term": "Winter", "verdict": "ambiguous", "word": "Cycle"}, {"term": "Zorb", "verdict": "none", "word": null} ],
      "why": "two terms receive the very same stretch: a block of a sentence they share, not the word of either; the question stays for both. A term with no line is not concerned" },
    { "id": "term_evidence/of_all/distinct-words-stay-words", "op": "of_all",
      "in": { "terms": ["Wheel", "Quest"], "lines": [
          {"key": "Big Wheel", "line": {"v": "Grande roue", "t": "V"}},
          {"key": "Wheel Lock", "line": {"v": "Verrou de roue", "t": "V"}},
          {"key": "Main Quest", "line": {"v": "Quête principale", "t": "V"}},
          {"key": "Side Quest", "line": {"v": "Quête annexe", "t": "V"}} ] },
      "out": [ {"term": "Wheel", "verdict": "word", "word": "roue"}, {"term": "Quest", "verdict": "word", "word": "Quête"} ],
      "why": "nothing shared: nothing ambiguous" }
  ]
}
