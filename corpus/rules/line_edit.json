      "v": "Touche",
      "t": "V",
      "term": true
     },
     "Gem": {
      "v": "Gemme",
      "t": "V",
      "term": true,
      "forms": {
       "f1": "gemmes"
      }
     },
     "Blank": {
      "v": "",
      "t": "H"
     }
    },
    "casing": "first-letter",
    "steps": [
     {
      "do": "finish"
     }
    ]
