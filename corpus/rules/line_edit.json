{
 "rule": "line_edit",
 "classes": [
  "LineEditing"
 ],
 "note": "Editing a sentence that holds links, the whole conversation (spec/translation-file/line-edit.md): open it, be told every change of the text, draw the preview, act on a passage, answer the question saving needs, and hand back the lines to write. `run` replays a script of gestures and compares what each gesture that SAYS something said, in order: the state is never compared, but an editor that rebuilt it from the text between two gestures would answer a second question with the first again. The sentence is written H by a person (M and S stay); the file is asked (LineWrites.Refusal) before a write is offered.",
 "operations": {
  "run": {
   "in": {
    "key": "string",
    "line": "a line or null",
    "current": "a line or absent",
    "file_format": "int (default 2)",
    "entries": "{key: line} — the file",
    "lists": "[names]",
    "casing": "?",
    "steps": "[{do: type|answer|unlink|link|mark_read|waiting|preview|finish, …}]"
   },
   "out": "[what each of unlink, link, mark_read, waiting, preview, finish said — type and answer say nothing]"
  },
  "term_choices": {
   "in": {
    "file": "{key: line}",
    "query": "string",
    "limit": "int (default 50)"
   },
   "out": "{items: [{key, text, forms:[{id,text}]}], total}"
  },
  "tag_of_words": {"in": {"stored": "string or null", "written": "string", "proposal": "string or null"}, "out": "the tag the words take when a person saves them: A when they are the AI's proposal kept as it came, else H (M and S stay)"},
    "tag_after_person": {
   "in": {
    "stored": "string or null"
   },
   "out": "the tag a person's writing takes"
  }
 },
