{
  "rule": "link_reading",
  "classes": ["LinkReading"],
  "note": "Reading a link (draft §3, §9): never a hole, never the marker. The CASE is the caller's: the socle holds no case mapping, so the executor's `casing: first-letter` is a stand-in (first UTF-16 character, invariant) that the cases below are written for — a port gives its own and the cases stay ASCII or Latin-1 on purpose.",
  "operations": {
    "read": {"in": {"link": "{to, form?, case?, by, was?}", "entries": "{key: line} — the lines of the file, in the file's form", "casing": "first-letter | absent (no casing function given)"}, "out": "{text, source (Form|Entry|Was|Key), case_not_applied}"},
    "needs_review": {"in": {"link": "as above", "read_text": "what `read` answered"}, "out": "bool"}
  },
  "cases": [
    { "id": "link_reading/read/form-asked", "op": "read",
      "in": {"link": {"by": "A", "to": "Star Coin", "form": "1", "was": "pièces d'étoile"}, "entries": {"Star Coin": {"v": "Pièce d'étoile", "t": "V", "forms": {"1": "pièces d'étoile", "2": "de la pièce d'étoile"}}, "Key": {"v": "Touche", "t": "V"}, "Blank": {"v": "", "t": "H"}, "Odd": {"v": "Bizarre", "t": "A", "forms": {"1": ""}}}},
      "out": {"text": "pièces d'étoile", "source": "Form", "case_not_applied": false},
      "why": "the form the link names, on the entry's line" },
    { "id": "link_reading/read/second-form", "op": "read",
      "in": {"link": {"by": "A", "to": "Star Coin", "form": "2", "was": "x"}, "entries": {"Star Coin": {"v": "Pièce d'étoile", "t": "V", "forms": {"1": "pièces d'étoile", "2": "de la pièce d'étoile"}}, "Key": {"v": "Touche", "t": "V"}, "Blank": {"v": "", "t": "H"}, "Odd": {"v": "Bizarre", "t": "A", "forms": {"1": ""}}}},
      "out": {"text": "de la pièce d'étoile", "source": "Form", "case_not_applied": false},
      "why": "each form is its own text: the one the sentence needs, not a rule applied to the entry" },
    { "id": "link_reading/read/upper-first", "op": "read",
      "in": {"link": {"by": "A", "to": "Star Coin", "form": "1", "case": "upper-first", "was": "Pièces d'étoile"}, "entries": {"Star Coin": {"v": "Pièce d'étoile", "t": "V", "forms": {"1": "pièces d'étoile", "2": "de la pièce d'étoile"}}, "Key": {"v": "Touche", "t": "V"}, "Blank": {"v": "", "t": "H"}, "Odd": {"v": "Bizarre", "t": "A", "forms": {"1": ""}}}, "casing": "first-letter"},
      "out": {"text": "Pièces d'étoile", "source": "Form", "case_not_applied": false},
      "why": "the sentence writes the first letter as a capital: the caller's function does it" },
    { "id": "link_reading/read/lower-first", "op": "read",
      "in": {"link": {"by": "A", "to": "Key", "case": "lower-first", "was": "touche"}, "entries": {"Star Coin": {"v": "Pièce d'étoile", "t": "V", "forms": {"1": "pièces d'étoile", "2": "de la pièce d'étoile"}}, "Key": {"v": "Touche", "t": "V"}, "Blank": {"v": "", "t": "H"}, "Odd": {"v": "Bizarre", "t": "A", "forms": {"1": ""}}}, "casing": "first-letter"},
      "out": {"text": "touche", "source": "Entry", "case_not_applied": false},
      "why": "or as a small letter, on the entry's own translation" },
    { "id": "link_reading/read/no-form-is-the-entry", "op": "read",
      "in": {"link": {"by": "A", "to": "Star Coin", "was": "x"}, "entries": {"Star Coin": {"v": "Pièce d'étoile", "t": "V", "forms": {"1": "pièces d'étoile", "2": "de la pièce d'étoile"}}, "Key": {"v": "Touche", "t": "V"}, "Blank": {"v": "", "t": "H"}, "Odd": {"v": "Bizarre", "t": "A", "forms": {"1": ""}}}},
      "out": {"text": "Pièce d'étoile", "source": "Entry", "case_not_applied": false},
      "why": "a link naming no form reads the entry's translation" },
    { "id": "link_reading/read/form-zero-is-the-entry", "op": "read",
      "in": {"link": {"by": "A", "to": "Star Coin", "form": "0", "was": "x"}, "entries": {"Star Coin": {"v": "Pièce d'étoile", "t": "V", "forms": {"1": "pièces d'étoile", "2": "de la pièce d'étoile"}}, "Key": {"v": "Touche", "t": "V"}, "Blank": {"v": "", "t": "H"}, "Odd": {"v": "Bizarre", "t": "A", "forms": {"1": ""}}}},
      "out": {"text": "Pièce d'étoile", "source": "Form", "case_not_applied": false},
      "why": "form 0 is the entry's own v, asked by name" },
    { "id": "link_reading/read/form-gone-is-the-entry", "op": "read",
      "in": {"link": {"by": "A", "to": "Star Coin", "form": "7", "was": "pièces"}, "entries": {"Star Coin": {"v": "Pièce d'étoile", "t": "V", "forms": {"1": "pièces d'étoile", "2": "de la pièce d'étoile"}}, "Key": {"v": "Touche", "t": "V"}, "Blank": {"v": "", "t": "H"}, "Odd": {"v": "Bizarre", "t": "A", "forms": {"1": ""}}}},
      "out": {"text": "Pièce d'étoile", "source": "Entry", "case_not_applied": false},
      "why": "the form no longer exists: the entry's translation, never a hole" },
    { "id": "link_reading/read/empty-form-is-gone", "op": "read",
      "in": {"link": {"by": "A", "to": "Odd", "form": "1", "was": "x"}, "entries": {"Star Coin": {"v": "Pièce d'étoile", "t": "V", "forms": {"1": "pièces d'étoile", "2": "de la pièce d'étoile"}}, "Key": {"v": "Touche", "t": "V"}, "Blank": {"v": "", "t": "H"}, "Odd": {"v": "Bizarre", "t": "A", "forms": {"1": ""}}}},
      "out": {"text": "Bizarre", "source": "Entry", "case_not_applied": false},
      "why": "a form with no text gives nothing to show: same as a form that is gone" },
    { "id": "link_reading/read/entry-gone-is-was", "op": "read",
      "in": {"link": {"by": "A", "to": "Missing", "form": "1", "was": "pièces d'étoile"}, "entries": {"Star Coin": {"v": "Pièce d'étoile", "t": "V", "forms": {"1": "pièces d'étoile", "2": "de la pièce d'étoile"}}, "Key": {"v": "Touche", "t": "V"}, "Blank": {"v": "", "t": "H"}, "Odd": {"v": "Bizarre", "t": "A", "forms": {"1": ""}}}},
      "out": {"text": "pièces d'étoile", "source": "Was", "case_not_applied": false},
      "why": "the entry no longer exists: what was read when the link was confirmed" },
    { "id": "link_reading/read/was-keeps-its-case", "op": "read",
      "in": {"link": {"by": "A", "to": "Missing", "case": "upper-first", "was": "pièces"}, "entries": {"Star Coin": {"v": "Pièce d'étoile", "t": "V", "forms": {"1": "pièces d'étoile", "2": "de la pièce d'étoile"}}, "Key": {"v": "Touche", "t": "V"}, "Blank": {"v": "", "t": "H"}, "Odd": {"v": "Bizarre", "t": "A", "forms": {"1": ""}}}, "casing": "first-letter"},
      "out": {"text": "pièces", "source": "Was", "case_not_applied": false},
      "why": "`was` is already the text as the sentence wrote it: the case is NOT applied to it a second time" },
    { "id": "link_reading/read/entry-without-translation-is-was", "op": "read",
      "in": {"link": {"by": "A", "to": "Blank", "was": "vide"}, "entries": {"Star Coin": {"v": "Pièce d'étoile", "t": "V", "forms": {"1": "pièces d'étoile", "2": "de la pièce d'étoile"}}, "Key": {"v": "Touche", "t": "V"}, "Blank": {"v": "", "t": "H"}, "Odd": {"v": "Bizarre", "t": "A", "forms": {"1": ""}}}},
      "out": {"text": "vide", "source": "Was", "case_not_applied": false},
      "why": "a captured line nobody translated has nothing to show: `was` stays" },
    { "id": "link_reading/read/nothing-left-is-the-key", "op": "read",
      "in": {"link": {"by": "A", "to": "Missing"}, "entries": {"Star Coin": {"v": "Pièce d'étoile", "t": "V", "forms": {"1": "pièces d'étoile", "2": "de la pièce d'étoile"}}, "Key": {"v": "Touche", "t": "V"}, "Blank": {"v": "", "t": "H"}, "Odd": {"v": "Bizarre", "t": "A", "forms": {"1": ""}}}},
      "out": {"text": "Missing", "source": "Key", "case_not_applied": false},
      "why": "even `was` missing, the game's own word: never a hole, never the marker" },
    { "id": "link_reading/read/no-casing-given", "op": "read",
      "in": {"link": {"by": "A", "to": "Star Coin", "form": "1", "case": "upper-first", "was": "x"}, "entries": {"Star Coin": {"v": "Pièce d'étoile", "t": "V", "forms": {"1": "pièces d'étoile", "2": "de la pièce d'étoile"}}, "Key": {"v": "Touche", "t": "V"}, "Blank": {"v": "", "t": "H"}, "Odd": {"v": "Bizarre", "t": "A", "forms": {"1": ""}}}},
      "out": {"text": "pièces d'étoile", "source": "Form", "case_not_applied": true},
      "why": "no casing function: the text as written, and it says it did not apply the case" },
    { "id": "link_reading/read/unknown-case-word", "op": "read",
      "in": {"link": {"by": "A", "to": "Star Coin", "form": "1", "case": "title", "was": "x"}, "entries": {"Star Coin": {"v": "Pièce d'étoile", "t": "V", "forms": {"1": "pièces d'étoile", "2": "de la pièce d'étoile"}}, "Key": {"v": "Touche", "t": "V"}, "Blank": {"v": "", "t": "H"}, "Odd": {"v": "Bizarre", "t": "A", "forms": {"1": ""}}}, "casing": "first-letter"},
      "out": {"text": "pièces d'étoile", "source": "Form", "case_not_applied": true},
      "why": "a case word this reader does not know (a newer writer's) is not applied, and said" },
    { "id": "link_reading/needs_review/same-text-is-not-to-read", "op": "needs_review",
      "in": {"link": {"by": "A", "to": "a", "was": "pièces d'étoile"}, "read_text": "pièces d'étoile"},
      "out": false,
      "why": "what the link reads is what it read when confirmed: nothing to read again" },
    { "id": "link_reading/needs_review/changed-text-is-to-read", "op": "needs_review",
      "in": {"link": {"by": "A", "to": "a", "was": "pièces d'étoile"}, "read_text": "pièces d'étoiles"},
      "out": true,
      "why": "the form moved on: the sentence must be read again" },
    { "id": "link_reading/needs_review/case-counts", "op": "needs_review",
      "in": {"link": {"by": "A", "to": "a", "was": "Pièces"}, "read_text": "pièces"},
      "out": true,
      "why": "compared exactly, case included" },
    { "id": "link_reading/needs_review/never-confirmed-is-to-read", "op": "needs_review",
      "in": {"link": {"to": "a", "by": "A"}, "read_text": "x"},
      "out": true,
      "why": "a link with no `was` was never confirmed" }
  ]
}
