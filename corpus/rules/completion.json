{
  "rule": "completion",
  "classes": ["Completion"],
  "note": "What a pass of UGT Manager's Smart does to a translation somebody already made (user, 2026-11-15: what is validated stays, what was never validated may go). `complete`: the lines of the file (key, line, rank), the lines of the pass, the keys of the pass that are terms, whether the result holds a game's lists section → every line in its order (the file's, then the new ones in the pass's order) with its verdict, the counts and the format of the result. Identity is the key, byte for byte: two different keys are two lines, never merged, never called duplicates. The pass's lines are tagged A when they come in; a line a person validated (H with words, V, S) is never modified, an H with nothing in it is a capture and counts as nothing; M is not a line of the game and is never marked. All the expected values are derived by hand from the decision, never from the code.",
  "operations": {
    "complete": { "in": { "mine": "list of {key, line, rank?}", "pass": "list of {key, line}", "terms": "list of keys of the pass that are terms", "holds_game_lists": "bool" }, "out": "{lines: [{key, verdict: kept|same|replaced|new|keptunvalidated, v, t, rank, term, marked, unlinked?}], new, validated_kept, replaced, marked, local_changes, format}" },
    "announcement": { "in": { "new": "int", "validated_kept": "int", "replaced": "int" }, "out": "string: the three counts the screen says before writing" }
  },
  "cases": [
    { "id": "completion/complete/a-file-with-nothing-takes-the-pass", "op": "complete",
      "in": { "mine": [], "pass": [ {"key": "Play", "line": {"v": "Jouer", "t": "A"}}, {"key": "Quit", "line": {"v": "Quitter", "t": "A"}} ], "terms": [], "holds_game_lists": false },
      "out": { "lines": [
          {"key": "Play", "verdict": "new", "v": "Jouer", "t": "A", "rank": 1, "term": false, "marked": false},
          {"key": "Quit", "verdict": "new", "v": "Quitter", "t": "A", "rank": 2, "term": false, "marked": false} ],
        "new": 2, "validated_kept": 0, "replaced": 0, "marked": 0, "local_changes": 2, "format": 1 },
      "why": "every key is new: tagged A, ranked after the largest of the file's (none: from 1), in the pass's order" },
    { "id": "completion/complete/what-a-person-validated-is-never-touched", "op": "complete",
      "in": { "mine": [ {"key": "Play", "line": {"v": "Lancer", "t": "V"}, "rank": 3} ], "pass": [ {"key": "Play", "line": {"v": "Jouer", "t": "A"}} ], "terms": [], "holds_game_lists": false },
      "out": { "lines": [ {"key": "Play", "verdict": "kept", "v": "Lancer", "t": "V", "rank": 3, "term": false, "marked": false} ],
        "new": 0, "validated_kept": 1, "replaced": 0, "marked": 0, "local_changes": 0, "format": 1 },
      "why": "the decision: a validated line stays, whatever the pass says, and is never asked again" },
    { "id": "completion/complete/h-and-s-stay-in-the-pass-or-not", "op": "complete",
      "in": { "mine": [ {"key": "Left", "line": {"v": "Gauche", "t": "H"}, "rank": 1}, {"key": "Skip", "line": {"v": "Skip", "t": "S"}, "rank": 2} ], "pass": [], "terms": [], "holds_game_lists": false },
      "out": { "lines": [
          {"key": "Left", "verdict": "kept", "v": "Gauche", "t": "H", "rank": 1, "term": false, "marked": false},
          {"key": "Skip", "verdict": "kept", "v": "Skip", "t": "S", "rank": 2, "term": false, "marked": false} ],
        "new": 0, "validated_kept": 2, "replaced": 0, "marked": 0, "local_changes": 0, "format": 1 },
      "why": "a person's words and a person's refusal are both validated; they are counted whether the pass has the key or not (252 of the 353 lines of a real file are such lines)" },
    { "id": "completion/complete/an-unvalidated-line-is-replaced-by-the-pass", "op": "complete",
      "in": { "mine": [ {"key": "Play", "line": {"v": "Lancer", "t": "A"}, "rank": 4} ], "pass": [ {"key": "Play", "line": {"v": "Jouer", "t": "A"}} ], "terms": [], "holds_game_lists": false },
      "out": { "lines": [ {"key": "Play", "verdict": "replaced", "v": "Jouer", "t": "A", "rank": 4, "term": false, "marked": false} ],
        "new": 0, "validated_kept": 0, "replaced": 1, "marked": 0, "local_changes": 1, "format": 1 },
      "why": "tag A is « never validated, may go »: the line of the pass takes its place and its rank is kept. This is not Merge.CanReplace, which gives nobody's place to a line of equal priority" },
    { "id": "completion/complete/the-same-words-change-nothing", "op": "complete",
      "in": { "mine": [ {"key": "Play", "line": {"v": "Jouer", "t": "A"}, "rank": 4} ], "pass": [ {"key": "Play", "line": {"v": "Jouer", "t": "A"}} ], "terms": [], "holds_game_lists": false },
      "out": { "lines": [ {"key": "Play", "verdict": "same", "v": "Jouer", "t": "A", "rank": 4, "term": false, "marked": false} ],
        "new": 0, "validated_kept": 0, "replaced": 0, "marked": 0, "local_changes": 0, "format": 1 },
      "why": "identical: nothing to write, nothing to count" },
    { "id": "completion/complete/an-unvalidated-line-the-pass-lacks-stays", "op": "complete",
      "in": { "mine": [ {"key": "Old", "line": {"v": "Ancien", "t": "A"}, "rank": 7} ], "pass": [], "terms": [], "holds_game_lists": false },
      "out": { "lines": [ {"key": "Old", "verdict": "keptunvalidated", "v": "Ancien", "t": "A", "rank": 7, "term": false, "marked": false} ],
        "new": 0, "validated_kept": 0, "replaced": 0, "marked": 0, "local_changes": 0, "format": 1 },
      "why": "a key the pass does not have is not a reason to remove a line: all his keys stay" },
    { "id": "completion/complete/a-capture-is-not-somebodys-work", "op": "complete",
      "in": { "mine": [ {"key": "Play", "line": {"v": "", "t": "H"}, "rank": 1} ], "pass": [ {"key": "Play", "line": {"v": "Jouer", "t": "A"}} ], "terms": [], "holds_game_lists": false },
      "out": { "lines": [ {"key": "Play", "verdict": "replaced", "v": "Jouer", "t": "A", "rank": 1, "term": false, "marked": false} ],
        "new": 0, "validated_kept": 0, "replaced": 1, "marked": 0, "local_changes": 1, "format": 1 },
      "why": "an H with nothing in it is « met in game, not written yet » (Merge.IsByHand): the pass fills it, and it is not counted among the validated" },
    { "id": "completion/complete/a-line-with-no-tag-reads-as-a", "op": "complete",
      "in": { "mine": [ {"key": "Play", "line": {"v": "Lancer"}, "rank": 2} ], "pass": [ {"key": "Play", "line": {"v": "Jouer", "t": "A"}} ], "terms": [], "holds_game_lists": false },
      "out": { "lines": [ {"key": "Play", "verdict": "replaced", "v": "Jouer", "t": "A", "rank": 2, "term": false, "marked": false} ],
        "new": 0, "validated_kept": 0, "replaced": 1, "marked": 0, "local_changes": 1, "format": 1 },
      "why": "the older file format wrote no tag and meant the machine's" },
    { "id": "completion/complete/the-mod-interface-is-never-touched-or-marked", "op": "complete",
      "in": { "mine": [ {"key": "Engine", "line": {"v": "Moteur", "t": "M"}, "rank": 2} ], "pass": [ {"key": "Engine", "line": {"v": "Moteur 2", "t": "A"}} ], "terms": ["Engine"], "holds_game_lists": false },
      "out": { "lines": [ {"key": "Engine", "verdict": "kept", "v": "Moteur", "t": "M", "rank": 2, "term": false, "marked": false} ],
        "new": 0, "validated_kept": 0, "replaced": 0, "marked": 0, "local_changes": 0, "format": 1 },
      "why": "M is not a line of the game (Merge.IsGameLine): neither replaced nor marked as a term, and not counted among the validated" },
    { "id": "completion/complete/a-validated-term-receives-only-the-mark", "op": "complete",
      "in": { "mine": [ {"key": "Engine", "line": {"v": "Moteur", "t": "V"}, "rank": 1} ], "pass": [ {"key": "Engine", "line": {"v": "Moteur", "t": "A"}} ], "terms": ["Engine"], "holds_game_lists": false },
      "out": { "lines": [ {"key": "Engine", "verdict": "kept", "v": "Moteur", "t": "V", "rank": 1, "term": true, "marked": true} ],
        "new": 0, "validated_kept": 1, "replaced": 0, "marked": 1, "local_changes": 1, "format": 2 },
      "why": "decision 3: the mark is added, the words and the V are not touched; the hash changes with the mark, so it counts as a local change, and the file holds a field of the format 2" },
    { "id": "completion/complete/a-term-already-marked-is-not-marked-again", "op": "complete",
      "in": { "mine": [ {"key": "Engine", "line": {"v": "Moteur", "t": "V", "term": true}, "rank": 1} ], "pass": [ {"key": "Engine", "line": {"v": "Moteur", "t": "A"}} ], "terms": ["Engine"], "holds_game_lists": false },
      "out": { "lines": [ {"key": "Engine", "verdict": "kept", "v": "Moteur", "t": "V", "rank": 1, "term": true, "marked": false} ],
        "new": 0, "validated_kept": 1, "replaced": 0, "marked": 0, "local_changes": 0, "format": 2 },
      "why": "nothing to add: no count; the file still holds a field of the format 2" },
    { "id": "completion/complete/an-unvalidated-term-with-the-same-words-is-marked", "op": "complete",
      "in": { "mine": [ {"key": "Engine", "line": {"v": "Moteur", "t": "A"}, "rank": 1} ], "pass": [ {"key": "Engine", "line": {"v": "Moteur", "t": "A"}} ], "terms": ["Engine"], "holds_game_lists": false },
      "out": { "lines": [ {"key": "Engine", "verdict": "same", "v": "Moteur", "t": "A", "rank": 1, "term": true, "marked": true} ],
        "new": 0, "validated_kept": 0, "replaced": 0, "marked": 1, "local_changes": 1, "format": 2 },
      "why": "same words, but the key is a term of the pass: the mark is the only change" },
    { "id": "completion/complete/a-new-term-comes-in-as-a-term", "op": "complete",
      "in": { "mine": [], "pass": [ {"key": "Engine", "line": {"v": "Moteur", "t": "A"}} ], "terms": ["Engine"], "holds_game_lists": false },
      "out": { "lines": [ {"key": "Engine", "verdict": "new", "v": "Moteur", "t": "A", "rank": 1, "term": true, "marked": false} ],
        "new": 1, "validated_kept": 0, "replaced": 0, "marked": 0, "local_changes": 1, "format": 2 },
      "why": "counted once, as a new line, not again as marked" },
    { "id": "completion/complete/a-replaced-term-is-a-term", "op": "complete",
      "in": { "mine": [ {"key": "Engine", "line": {"v": "Mot", "t": "A"}, "rank": 1} ], "pass": [ {"key": "Engine", "line": {"v": "Moteur", "t": "A"}} ], "terms": ["Engine"], "holds_game_lists": false },
      "out": { "lines": [ {"key": "Engine", "verdict": "replaced", "v": "Moteur", "t": "A", "rank": 1, "term": true, "marked": false} ],
        "new": 0, "validated_kept": 0, "replaced": 1, "marked": 0, "local_changes": 1, "format": 2 },
      "why": "counted once, as replaced" },
    { "id": "completion/complete/new-lines-follow-the-largest-rank-in-the-pass-order", "op": "complete",
      "in": { "mine": [ {"key": "a", "line": {"v": "A", "t": "V"}, "rank": 5}, {"key": "b", "line": {"v": "B", "t": "V"}, "rank": 9} ],
              "pass": [ {"key": "a", "line": {"v": "x", "t": "A"}}, {"key": "c", "line": {"v": "C", "t": "A"}}, {"key": "d", "line": {"v": "D", "t": "A"}} ], "terms": [], "holds_game_lists": false },
      "out": { "lines": [
          {"key": "a", "verdict": "kept", "v": "A", "t": "V", "rank": 5, "term": false, "marked": false},
          {"key": "b", "verdict": "kept", "v": "B", "t": "V", "rank": 9, "term": false, "marked": false},
          {"key": "c", "verdict": "new", "v": "C", "t": "A", "rank": 10, "term": false, "marked": false},
          {"key": "d", "verdict": "new", "v": "D", "t": "A", "rank": 11, "term": false, "marked": false} ],
        "new": 2, "validated_kept": 2, "replaced": 0, "marked": 0, "local_changes": 2, "format": 1 },
      "why": "his ranks stay (the mod renumbers by object identity, never guessed); the new ones take the next ones, in the pass's order, after all his lines" },
    { "id": "completion/complete/two-keys-are-two-lines", "op": "complete",
      "in": { "mine": [ {"key": "Left Click", "line": {"v": "Clic gauche", "t": "V"}, "rank": 1} ], "pass": [ {"key": "Left click", "line": {"v": "Clic", "t": "A"}} ], "terms": [], "holds_game_lists": false },
      "out": { "lines": [
          {"key": "Left Click", "verdict": "kept", "v": "Clic gauche", "t": "V", "rank": 1, "term": false, "marked": false},
          {"key": "Left click", "verdict": "new", "v": "Clic", "t": "A", "rank": 2, "term": false, "marked": false} ],
        "new": 1, "validated_kept": 1, "replaced": 0, "marked": 0, "local_changes": 1, "format": 1 },
      "why": "user: « j'ai mangé des chips et j'ai mangé des tacos, c'est pas la même chose »: a different key is a different line, nothing is close, nothing is merged" },
    { "id": "completion/complete/a-persons-refusal-of-a-link-survives-a-replacement", "op": "complete",
      "in": { "mine": [ {"key": "Need [!g*0]", "line": {"v": "Il faut [!g*0]", "t": "A", "unlinked": [{"to": "Star"}]}, "rank": 1} ],
              "pass": [ {"key": "Need [!g*0]", "line": {"v": "Il faut vite [!g*0]", "t": "A", "unlinked": [{"to": "Moon"}]}} ], "terms": [], "holds_game_lists": false },
      "out": { "lines": [ {"key": "Need [!g*0]", "verdict": "replaced", "v": "Il faut vite [!g*0]", "t": "A", "rank": 1, "term": false, "marked": false, "unlinked": ["Star", "Moon"]} ],
        "new": 0, "validated_kept": 0, "replaced": 1, "marked": 0, "local_changes": 1, "format": 2 },
      "why": "a person's « this sentence does not name that entry » is an authority no extraction takes back: kept beside the pass's" },
    { "id": "completion/complete/the-pass-lists-make-the-file-a-format-2", "op": "complete",
      "in": { "mine": [], "pass": [ {"key": "Play", "line": {"v": "Jouer", "t": "A"}} ], "terms": [], "holds_game_lists": true },
      "out": { "lines": [ {"key": "Play", "verdict": "new", "v": "Jouer", "t": "A", "rank": 1, "term": false, "marked": false} ],
        "new": 1, "validated_kept": 0, "replaced": 0, "marked": 0, "local_changes": 1, "format": 2 },
      "why": "the format is that of what the file CONTAINS (OfContent): the lists section is what makes it a format 2" },
    { "id": "completion/announcement/a-real-file", "op": "announcement",
      "in": { "new": 751, "validated_kept": 252, "replaced": 12 },
      "out": "751 new lines · 252 validated lines kept · 12 unvalidated lines replaced",
      "why": "the three counts the user asked for, in his order" },
    { "id": "completion/announcement/one-of-each", "op": "announcement",
      "in": { "new": 1, "validated_kept": 1, "replaced": 1 },
      "out": "1 new line · 1 validated line kept · 1 unvalidated line replaced",
      "why": "one is not « 1 lines »" },
    { "id": "completion/announcement/nothing", "op": "announcement",
      "in": { "new": 0, "validated_kept": 0, "replaced": 0 },
      "out": "0 new lines · 0 validated lines kept · 0 unvalidated lines replaced",
      "why": "zero takes the plural, and the sentence is still said" }
  ]
}
