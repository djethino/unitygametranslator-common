{
  "rule": "key_shape",
  "classes": ["KeyShape"],
  "note": "The shape a text's KEY is stored in (spec/translation-file/key.md): line ends made LF, then numbers lifted into `[!v*N]` slots when the setting says so; Stored is that, trimmed. Reproduces the mod's TextGate.KeyShape (without the game's variables) and TextNormalization exactly, with Unicode's digits and white space at the project's pinned version instead of the runtime's. The larger body of evidence is corpus/data/key-vectors.json, produced by the mod's own function.",
  "operations": {
    "of": {"in": {"text": "string or null", "normalize_numbers": "bool"}, "out": "{key, numbers}"},
    "stored": {"in": {"text": "string or null"}, "out": "the key as a cold translation writes it"},
    "restore": {"in": {"text": "string or null", "numbers": "[string] in slot order"}, "out": "the text with its slots filled"},
    "restore_by_slot": {"in": {"text": "string", "numbers": "{slot: string}"}, "out": "the same, numbers held by slot"},
    "unbrace": {"in": {"key": "string"}, "out": "the key with its braced number slots unbraced"},
    "rebrace": {"in": {"translation": "string", "braced_key": "string"}, "out": "the translation in the written shape, or null"}
  },
  "cases": [
    { "id": "key_shape/of/a-number", "op": "of",
      "in": {"text": "Level 5", "normalize_numbers": true},
      "out": {"key": "Level [!v*0]", "numbers": ["5"]},
      "why": "a number is lifted into a slot, numbered in order of appearance" },
    { "id": "key_shape/of/two-numbers", "op": "of",
      "in": {"text": "HP: 120/300", "normalize_numbers": true},
      "out": {"key": "HP: [!v*0]/[!v*1]", "numbers": ["120", "300"]},
      "why": "in order" },
    { "id": "key_shape/of/a-sign-goes-with-its-number", "op": "of",
      "in": {"text": "-3", "normalize_numbers": true},
      "out": {"key": "[!v*0]", "numbers": ["-3"]},
      "why": "a minus sign before a digit is part of the number" },
    { "id": "key_shape/of/a-range-is-a-number-and-a-signed-one", "op": "of",
      "in": {"text": "2-5", "normalize_numbers": true},
      "out": {"key": "[!v*0][!v*1]", "numbers": ["2", "-5"]},
      "why": "the pass reads a sign before ANY digit: « 2-5 » is `2` and `-5`" },
    { "id": "key_shape/of/a-sign-in-the-middle-of-a-word", "op": "of",
      "in": {"text": "a-5", "normalize_numbers": true},
      "out": {"key": "a[!v*0]", "numbers": ["-5"]},
      "why": "the same, after a letter" },
    { "id": "key_shape/of/a-sign-alone", "op": "of",
      "in": {"text": "x- 5", "normalize_numbers": true},
      "out": {"key": "x- [!v*0]", "numbers": ["5"]},
      "why": "a minus not followed by a digit is a character of the text" },
    { "id": "key_shape/of/a-percent-goes-with-its-number", "op": "of",
      "in": {"text": "50%", "normalize_numbers": true},
      "out": {"key": "[!v*0]", "numbers": ["50%"]},
      "why": "one `%` right after the number is part of it" },
    { "id": "key_shape/of/two-percents", "op": "of",
      "in": {"text": "100%%", "normalize_numbers": true},
      "out": {"key": "[!v*0]%", "numbers": ["100%"]},
      "why": "only one" },
    { "id": "key_shape/of/a-decimal-point-or-comma", "op": "of",
      "in": {"text": "3.5 and 3,5", "normalize_numbers": true},
      "out": {"key": "[!v*0] and [!v*1]", "numbers": ["3.5", "3,5"]},
      "why": "the decimal mark is the ASCII « . » or « , » followed by digits — no culture" },
    { "id": "key_shape/of/thousands-marks-are-not-read", "op": "of",
      "in": {"text": "1,000,000", "normalize_numbers": true},
      "out": {"key": "[!v*0],[!v*1]", "numbers": ["1,000", "000"]},
      "why": "🔴 A FACT OF THE KEY, not a defect: « 1,000,000 » is two slots (`1,000` then `000`) — the keys of files already written hold it; correcting it is a migration" },
    { "id": "key_shape/of/two-points", "op": "of",
      "in": {"text": "1.2.3", "normalize_numbers": true},
      "out": {"key": "[!v*0].[!v*1]", "numbers": ["1.2", "3"]},
      "why": "the second point is the text; `3` is another number" },
    { "id": "key_shape/of/a-trailing-point", "op": "of",
      "in": {"text": "3.", "normalize_numbers": true},
      "out": {"key": "[!v*0].", "numbers": ["3"]},
      "why": "a mark with no digit after it is not part of the number" },
    { "id": "key_shape/of/a-comma-and-a-letter", "op": "of",
      "in": {"text": "5,a", "normalize_numbers": true},
      "out": {"key": "[!v*0],a", "numbers": ["5"]},
      "why": "same" },
    { "id": "key_shape/of/a-letter-between-digits", "op": "of",
      "in": {"text": "1e5", "normalize_numbers": true},
      "out": {"key": "[!v*0]e[!v*1]", "numbers": ["1", "5"]},
      "why": "no exponent: two numbers" },
    { "id": "key_shape/of/a-hexadecimal-colour-is-kept", "op": "of",
      "in": {"text": "#FF0000", "normalize_numbers": true},
      "out": {"key": "#FF0000", "numbers": []},
      "why": "the digits that follow a « # » and hexadecimal characters are a colour" },
    { "id": "key_shape/of/a-hexadecimal-colour-then-a-number", "op": "of",
      "in": {"text": "color #ff00ff 5", "normalize_numbers": true},
      "out": {"key": "color #ff00ff [!v*0]", "numbers": ["5"]},
      "why": "the colour is kept, the number after it is lifted (and takes the first slot)" },
    { "id": "key_shape/of/digits-right-after-a-hash", "op": "of",
      "in": {"text": "#12", "normalize_numbers": true},
      "out": {"key": "#12", "numbers": []},
      "why": "the run before the number is empty and « # » stands right there" },
    { "id": "key_shape/of/a-slot-already-there", "op": "of",
      "in": {"text": "[!v*12] y", "normalize_numbers": true},
      "out": {"key": "[!v*12] y", "numbers": []},
      "why": "the digits of a slot are not numbers" },
    { "id": "key_shape/of/a-str-slot-already-there", "op": "of",
      "in": {"text": "[!STR*3] 4", "normalize_numbers": true},
      "out": {"key": "[!STR*3] [!v*0]", "numbers": ["4"]},
      "why": "a `[!STR*N]` is a slot too; the number after it is lifted" },
    { "id": "key_shape/of/a-new-slot-is-numbered-by-rank", "op": "of",
      "in": {"text": "[!v*0] x 2", "normalize_numbers": true},
      "out": {"key": "[!v*0] x [!v*0]", "numbers": ["2"]},
      "why": "the slot of a lifted number is its rank among the lifted ones, whatever slots the text already holds (a caller keeps them apart)" },
    { "id": "key_shape/of/arabic-indic-digits", "op": "of",
      "in": {"text": "٣٤ x", "normalize_numbers": true},
      "out": {"key": "[!v*0] x", "numbers": ["٣٤"]},
      "why": "a digit of any script (Nd) is a digit" },
    { "id": "key_shape/of/fullwidth-digits", "op": "of",
      "in": {"text": "１２", "normalize_numbers": true},
      "out": {"key": "[!v*0]", "numbers": ["１２"]},
      "why": "fullwidth digits too" },
    { "id": "key_shape/of/digits-of-two-scripts-are-one-number", "op": "of",
      "in": {"text": "1٣", "normalize_numbers": true},
      "out": {"key": "[!v*0]", "numbers": ["1٣"]},
      "why": "a run of digits is a run of digits" },
    { "id": "key_shape/of/an-arabic-decimal-number", "op": "of",
      "in": {"text": "٣.٥", "normalize_numbers": true},
      "out": {"key": "[!v*0]", "numbers": ["٣.٥"]},
      "why": "the decimal point is still the ASCII one" },
    { "id": "key_shape/of/a-digit-outside-the-plane-is-no-number", "op": "of",
      "in": {"text": "𝟘", "normalize_numbers": true},
      "out": {"key": "𝟘", "numbers": []},
      "why": "🔴 the key is read by UTF-16 unit, as the runtime's expression read it: a digit outside the Basic Multilingual Plane is two surrogates, no number — a fact of the key, said, not corrected without a migration" },
    { "id": "key_shape/of/line-ends-first", "op": "of",
      "in": {"text": "a\r\n5\rb", "normalize_numbers": true},
      "out": {"key": "a\n[!v*0]\nb", "numbers": ["5"]},
      "why": "line ends become LF before anything is read" },
    { "id": "key_shape/of/numbers-not-asked", "op": "of",
      "in": {"text": "Level 5", "normalize_numbers": false},
      "out": {"key": "Level 5", "numbers": []},
      "why": "with the setting off the numbers stay where they are" },
    { "id": "key_shape/of/numbers-not-asked-line-ends-still-made-one", "op": "of",
      "in": {"text": "a\r\nb 5", "normalize_numbers": false},
      "out": {"key": "a\nb 5", "numbers": []},
      "why": "but the line ends are made one" },
    { "id": "key_shape/of/nothing-to-change", "op": "of",
      "in": {"text": "Hello world", "normalize_numbers": true},
      "out": {"key": "Hello world", "numbers": []},
      "why": "a text with no number comes back as it is" },
    { "id": "key_shape/of/empty", "op": "of",
      "in": {"text": "", "normalize_numbers": true},
      "out": {"key": "", "numbers": []},
      "why": "nothing" },
    { "id": "key_shape/of/null", "op": "of",
      "in": {"text": null, "normalize_numbers": true},
      "out": {"key": null, "numbers": []},
      "why": "no text stays no text" },
    { "id": "key_shape/stored/trimmed-key", "op": "stored",
      "in": {"text": "  Level 5 \n"},
      "out": "Level [!v*0]",
      "why": "the key a cold translation writes: numbers lifted, trimmed" },
    { "id": "key_shape/stored/trimmed-no-break-spaces", "op": "stored",
      "in": {"text": " x "},
      "out": "x",
      "why": "the no-break space and the ideographic space are white space" },
    { "id": "key_shape/stored/a-zero-width-space-stays", "op": "stored",
      "in": {"text": "​x"},
      "out": "​x",
      "why": "U+200B is not White_Space" },
    { "id": "key_shape/stored/mongolian-vowel-separator-stays", "op": "stored",
      "in": {"text": "᠎x"},
      "out": "᠎x",
      "why": "U+180E left White_Space long ago" },
    { "id": "key_shape/stored/a-line-end-then-a-number", "op": "stored",
      "in": {"text": "\r\n 7"},
      "out": "[!v*0]",
      "why": "line ends first, then trimmed" },
    { "id": "key_shape/stored/nothing-to-trim", "op": "stored",
      "in": {"text": "Hello"},
      "out": "Hello",
      "why": "as it is" },
    { "id": "key_shape/restore/slots-get-their-numbers", "op": "restore",
      "in": {"text": "[!v*0] and [!v*1]", "numbers": ["3", "4"]},
      "out": "3 and 4",
      "why": "the inverse of the lifting" },
    { "id": "key_shape/restore/a-slot-without-a-number-stays", "op": "restore",
      "in": {"text": "[!v*0] [!v*2]", "numbers": ["9"]},
      "out": "9 [!v*2]",
      "why": "nothing invented" },
    { "id": "key_shape/restore/no-numbers", "op": "restore",
      "in": {"text": "[!v*0]", "numbers": []},
      "out": "[!v*0]",
      "why": "as it is" },
    { "id": "key_shape/restore/null", "op": "restore",
      "in": {"text": null, "numbers": ["1"]},
      "out": null,
      "why": "no text stays no text" },
    { "id": "key_shape/restore_by_slot/by-slot", "op": "restore_by_slot",
      "in": {"text": "[!v*1] et [!v*0]", "numbers": {"0": "a", "1": "b"}},
      "out": "b et a",
      "why": "the same for a caller that holds the numbers by slot" },
    { "id": "key_shape/unbrace/a-braced-slot", "op": "unbrace",
      "in": {"key": "{[!v*0]} damage"},
      "out": "[!v*0] damage",
      "why": "the shape of the same text once the game has formatted it" },
    { "id": "key_shape/unbrace/sign-and-percent-go-with-it", "op": "unbrace",
      "in": {"key": "-{[!v*1]}%"},
      "out": "[!v*1]",
      "why": "a sign before and a `%` after are the number's: they go with the slot" },
    { "id": "key_shape/unbrace/two-slots", "op": "unbrace",
      "in": {"key": "{[!v*0]}{[!v*1]}"},
      "out": "[!v*0][!v*1]",
      "why": "each one" },
    { "id": "key_shape/unbrace/a-format-hole-is-not-a-slot", "op": "unbrace",
      "in": {"key": "{0}"},
      "out": "{0}",
      "why": "only a braced SLOT" },
    { "id": "key_shape/unbrace/not-a-number", "op": "unbrace",
      "in": {"key": "{[!v*x]}"},
      "out": "{[!v*x]}",
      "why": "a slot has digits" },
    { "id": "key_shape/rebrace/a-slot-is-braced-again", "op": "rebrace",
      "in": {"translation": "[!v*0] dégâts", "braced_key": "{[!v*0]} damage"},
      "out": "{[!v*0]} dégâts",
      "why": "the inverse of Unbrace" },
    { "id": "key_shape/rebrace/sign-and-percent-come-back", "op": "rebrace",
      "in": {"translation": "[!v*0]", "braced_key": "-{[!v*0]}%"},
      "out": "-{[!v*0]}%",
      "why": "with their sign and their `%`" },
    { "id": "key_shape/rebrace/a-slot-the-translation-lacks", "op": "rebrace",
      "in": {"translation": "rien", "braced_key": "{[!v*0]} damage"},
      "out": null,
      "why": "null: the translation cannot be put in the written shape" },
    { "id": "key_shape/rebrace/a-slot-twice", "op": "rebrace",
      "in": {"translation": "[!v*0] et [!v*0]", "braced_key": "{[!v*0]} damage"},
      "out": null,
      "why": "null: nobody chooses which one" },
    { "id": "key_shape/rebrace/already-braced", "op": "rebrace",
      "in": {"translation": "{[!v*0]} x", "braced_key": "{[!v*0]} damage"},
      "out": "{[!v*0]} x",
      "why": "a slot the translation already braced is left" }
  ]
}
