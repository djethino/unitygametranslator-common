   "out": false,
   "why": "one code point to one: its capital is two letters, so it is its own letter"
  },
  {
   "id": "game_names/same/cyrillic",
   "op": "same",
   "in": {
    "a": "\u041f\u0440\u0438\u0432\u0435\u0442 \u043c\u0438\u0440",
