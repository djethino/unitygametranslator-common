{
 "rule": "game_names",
 "classes": [
  "GameNames"
 ],
 "note": "When two names are the same game's title: case, spaces and punctuation aside, by the letters and numbers (L and N, any script, any plane, by code point). The site's `GameNaming::flatten` answers the same with its engine's `\\p{L}\\p{N}` and `mb_strtolower`: held by the `same` vectors, which only use characters that engine knows (PHP 8.4 / PCRE2 10.44 is behind Unicode 18, and a browser's ICU differs again). `flat` is the socle's own form (in capitals): a port is not asked for it. Known differences with the site, on no real title: the Greek final sigma is one letter here, two there.",
 "operations": {
  "same": {
   "in": {
    "a": "string",
    "b": "string"
   },
   "out": "bool: both names flatten to something, and to the same thing"
  },
  "flat": {
   "in": {
    "name": "string or null"
   },
   "out": "the name's letters and numbers, in capitals (the socle's form; not a port's)"
  },
  "which": {
   "in": {
    "candidates": "list of names, in the server's order",
    "asked": "string or null: the name searched with, null when found by Steam id"
   },
   "out": "{chosen: indices kept, ambiguous: bool}"
  }
 },
 "cases": [
  {
   "id": "game_names/same/case-and-punctuation",
   "op": "same",
   "in": {
    "a": "Hollow Knight",
    "b": "hollow-knight"
   },
   "out": true,
   "why": "the whole difference between a shop title and a product name"
  },
  {
   "id": "game_names/same/short-name-is-not-the-title",
   "op": "same",
   "in": {
    "a": "LONESTAR",
    "b": "LoneStar: The Game"
   },
   "out": false,
   "why": "equal means equal: that one name holds the other is another question (the caller's)"
  },
  {
   "id": "game_names/same/short-title",
   "op": "same",
   "in": {
    "a": "Rez",
    "b": "REZ"
   },
   "out": true,
   "why": "a three-letter title is a title"
  },
  {
   "id": "game_names/same/punctuation-only-difference",
   "op": "same",
   "in": {
    "a": "HALP!",
    "b": "halp"
   },
   "out": true,
   "why": ""
  },
  {
   "id": "game_names/same/han",
   "op": "same",
   "in": {
    "a": "\u9f99\u80e4\u7acb\u5fd7\u4f20",
    "b": "\u9f99\u80e4\u7acb\u5fd7\u4f20"
   },
   "out": true,
   "why": "a title in another script is not emptied"
  },
  {
   "id": "game_names/same/han-another-title",
   "op": "same",
   "in": {
    "a": "\u9f99\u80e4\u7acb\u5fd7\u4f20",
    "b": "\u9f99\u80e4\u7acb\u5fd7"
   },
   "out": false,
   "why": ""
  },
  {
   "id": "game_names/same/accents-fold-with-case",
   "op": "same",
   "in": {
    "a": "Caf\u00e9",
    "b": "CAF\u00c9"
   },
   "out": true,
   "why": ""
  },
  {
   "id": "game_names/same/an-accent-is-a-letter",
   "op": "same",
   "in": {
    "a": "Caf\u00e9",
    "b": "Cafe"
   },
   "out": false,
   "why": ""
  },
  {
   "id": "game_names/same/a-letter-beyond-the-plane-is-kept",
   "op": "same",
   "in": {
    "a": "\ud842\udfb7\u91ce\u5bb6",
    "b": "\u91ce\u5bb6"
   },
   "out": false,
   "why": "U+20BB7 is a letter: it makes the names two (read by UTF-16 unit, it was dropped and they were one)"
  },
  {
   "id": "game_names/same/spaces-inside-are-nothing",
   "op": "same",
   "in": {
    "a": "\ud842\udfb7\u91ce\u5bb6",
    "b": "\ud842\udfb7 \u91ce \u5bb6"
   },
   "out": true,
   "why": ""
  },
  {
   "id": "game_names/same/roman-numeral-has-its-case",
   "op": "same",
   "in": {
    "a": "\u2167",
    "b": "\u2177"
   },
   "out": true,
   "why": "Nl is a number and is kept: both cases of it"
  },
  {
   "id": "game_names/same/roman-numeral-is-not-a-digit",
   "op": "same",
   "in": {
    "a": "\u2167",
    "b": "8"
   },
   "out": false,
   "why": "kept, not read as an 8"
  },
  {
   "id": "game_names/same/superscript-is-kept",
   "op": "same",
   "in": {
    "a": "\u00b2",
    "b": "2"
   },
   "out": false,
   "why": "No is a number"
  },
  {
   "id": "game_names/same/digits",
   "op": "same",
   "in": {
    "a": "Area 51",
    "b": "area-51"
   },
   "out": true,
   "why": ""
  },
  {
   "id": "game_names/same/another-number",
   "op": "same",
   "in": {
    "a": "Area 51",
    "b": "Area 5"
   },
   "out": false,
   "why": ""
  },
  {
   "id": "game_names/same/nothing-to-compare",
   "op": "same",
   "in": {
    "a": "!!!",
    "b": "???"
   },
   "out": false,
   "why": "two names that flatten to nothing are not the same name: there is nothing to say"
  },
  {
