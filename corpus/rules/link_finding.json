{
  "rule": "link_finding",
  "classes": ["LinkFinding"],
  "note": "Finding links in a text nobody typed (spec/translation-file/finding.md). `terms` are the lines of the file that carry the term mark; the index is built from them once. A term is a candidate only if the SOURCE cites it (its key, at word edges, the longest first, never overlapping); its writings are then looked for in the text; ONE occurrence is a link (by A), none or several is none; a link a person set is kept when its exact words (`own` first) are found once, and named in not_found otherwise. Word edges: WordGlue. Nothing is ever rewritten.",
  "operations": {
    "find": {"in": {"terms": "{key: line} — the term lines", "text": "string", "source": "string", "before": "line | null"}, "out": "{v, links, not_found, problem}"}
  },
  "cases": [
    { "id": "link_finding/find/one-occurrence-is-a-link", "op": "find",
      "in": {"terms": {"Star Coin": {"v": "Pièce d'étoile", "t": "V", "term": true, "forms": {"f1": "pièces d'étoile", "f2": "de la pièce d'étoile"}}, "Coin": {"v": "Pièce", "t": "V", "term": true}, "Key": {"v": "Touche", "t": "V", "term": true, "forms": {"f1": "touches"}}, "Door": {"v": "Porte", "t": "V", "term": true}}, "text": "Il faut une pièce d'étoile.", "source": "Needs a Star Coin."},
      "out": {"v": "Il faut une [!g*0].", "links": [{"to": "Star Coin", "by": "A", "was": "pièce d'étoile", "case": "lower-first"}], "not_found": [], "problem": null},
      "why": "the source cites « Star Coin »; its value is found once, with its first letter in the other case: a link `by: A` with that case" },
    { "id": "link_finding/find/a-form-is-found", "op": "find",
      "in": {"terms": {"Star Coin": {"v": "Pièce d'étoile", "t": "V", "term": true, "forms": {"f1": "pièces d'étoile", "f2": "de la pièce d'étoile"}}, "Coin": {"v": "Pièce", "t": "V", "term": true}, "Key": {"v": "Touche", "t": "V", "term": true, "forms": {"f1": "touches"}}, "Door": {"v": "Porte", "t": "V", "term": true}}, "text": "Pas assez de pièces d'étoile !", "source": "Not enough Star Coin !"},
      "out": {"v": "Pas assez de [!g*0] !", "links": [{"to": "Star Coin", "by": "A", "was": "pièces d'étoile", "form": "f1"}], "not_found": [], "problem": null},
      "why": "the written form the model used is the one linked: the program reads the model's choice, it never makes it" },
    { "id": "link_finding/find/the-value-as-it-is", "op": "find",
      "in": {"terms": {"Star Coin": {"v": "Pièce d'étoile", "t": "V", "term": true, "forms": {"f1": "pièces d'étoile", "f2": "de la pièce d'étoile"}}, "Coin": {"v": "Pièce", "t": "V", "term": true}, "Key": {"v": "Touche", "t": "V", "term": true, "forms": {"f1": "touches"}}, "Door": {"v": "Porte", "t": "V", "term": true}}, "text": "Pièce d'étoile requise", "source": "Star Coin needed"},
      "out": {"v": "[!g*0] requise", "links": [{"to": "Star Coin", "by": "A", "was": "Pièce d'étoile"}], "not_found": [], "problem": null},
      "why": "the very letters: no case" },
    { "id": "link_finding/find/none-found-nothing-changes", "op": "find",
      "in": {"terms": {"Star Coin": {"v": "Pièce d'étoile", "t": "V", "term": true, "forms": {"f1": "pièces d'étoile", "f2": "de la pièce d'étoile"}}, "Coin": {"v": "Pièce", "t": "V", "term": true}, "Key": {"v": "Touche", "t": "V", "term": true, "forms": {"f1": "touches"}}, "Door": {"v": "Porte", "t": "V", "term": true}}, "text": "Il faut une gemme.", "source": "Needs a Star Coin."},
      "out": {"v": "Il faut une gemme.", "links": [], "not_found": [], "problem": null},
      "why": "the term is cited and not written: no link, and nothing else — the text is never corrected" },
    { "id": "link_finding/find/twice-is-no-link", "op": "find",
      "in": {"terms": {"Star Coin": {"v": "Pièce d'étoile", "t": "V", "term": true, "forms": {"f1": "pièces d'étoile", "f2": "de la pièce d'étoile"}}, "Coin": {"v": "Pièce", "t": "V", "term": true}, "Key": {"v": "Touche", "t": "V", "term": true, "forms": {"f1": "touches"}}, "Door": {"v": "Porte", "t": "V", "term": true}}, "text": "Une pièce d'étoile et une pièce d'étoile.", "source": "A Star Coin and a Star Coin"},
      "out": {"v": "Une pièce d'étoile et une pièce d'étoile.", "links": [], "not_found": []},
      "why": "two occurrences: nobody chooses which one is the term — no link at all" },
    { "id": "link_finding/find/the-source-must-cite-it", "op": "find",
      "in": {"terms": {"Star Coin": {"v": "Pièce d'étoile", "t": "V", "term": true, "forms": {"f1": "pièces d'étoile", "f2": "de la pièce d'étoile"}}, "Coin": {"v": "Pièce", "t": "V", "term": true}, "Key": {"v": "Touche", "t": "V", "term": true, "forms": {"f1": "touches"}}, "Door": {"v": "Porte", "t": "V", "term": true}}, "text": "Une pièce d'étoile.", "source": "A gem"},
      "out": {"v": "Une pièce d'étoile.", "links": [], "not_found": []},
      "why": "a link is known by the SOURCE, never guessed from the translation: the words are there, the source does not cite the term" },
    { "id": "link_finding/find/a-plural-is-not-the-term", "op": "find",
      "in": {"terms": {"Star Coin": {"v": "Pièce d'étoile", "t": "V", "term": true, "forms": {"f1": "pièces d'étoile", "f2": "de la pièce d'étoile"}}, "Coin": {"v": "Pièce", "t": "V", "term": true}, "Key": {"v": "Touche", "t": "V", "term": true, "forms": {"f1": "touches"}}, "Door": {"v": "Porte", "t": "V", "term": true}}, "text": "Une pièce d'étoile.", "source": "Two Star Coins"},
      "out": {"v": "Une pièce d'étoile.", "links": [], "not_found": []},
      "why": "« Star Coins » does not cite « Star Coin »: no ending is allowed (the prototype allowed up to half the word and cited too much: 1 205 pairs became 2 347 on one game); a plural of the source is a term only if the file has a term for it" },
    { "id": "link_finding/find/a-longer-word-hides-the-writing", "op": "find",
      "in": {"terms": {"Star Coin": {"v": "Pièce d'étoile", "t": "V", "term": true, "forms": {"f1": "pièces d'étoile", "f2": "de la pièce d'étoile"}}, "Coin": {"v": "Pièce", "t": "V", "term": true}, "Key": {"v": "Touche", "t": "V", "term": true, "forms": {"f1": "touches"}}, "Door": {"v": "Porte", "t": "V", "term": true}}, "text": "Les pièce d'étoiles.", "source": "A Star Coin"},
      "out": {"v": "Les pièce d'étoiles.", "links": [], "not_found": []},
      "why": "the writing is the start of a longer word: it is not an occurrence" },
    { "id": "link_finding/find/a-hyphen-is-an-edge", "op": "find",
      "in": {"terms": {"Star Coin": {"v": "Pièce d'étoile", "t": "V", "term": true, "forms": {"f1": "pièces d'étoile", "f2": "de la pièce d'étoile"}}, "Coin": {"v": "Pièce", "t": "V", "term": true}, "Key": {"v": "Touche", "t": "V", "term": true, "forms": {"f1": "touches"}}, "Door": {"v": "Porte", "t": "V", "term": true}}, "text": "une carte-touche", "source": "Key card"},
      "out": {"v": "une carte-[!g*0]", "links": [{"to": "Key", "by": "A", "was": "touche", "case": "lower-first"}], "not_found": [], "problem": null},
      "why": "« touche » in « carte-touche » is an occurrence: the hyphen is no letter. Found once it is a link `by: A`, in colour, and the person can unlink it — nothing cleverer is attempted" },
    { "id": "link_finding/find/an-apostrophe-is-an-edge", "op": "find",
      "in": {"terms": {"Star Coin": {"v": "Pièce d'étoile", "t": "V", "term": true, "forms": {"f1": "pièces d'étoile", "f2": "de la pièce d'étoile"}}, "Coin": {"v": "Pièce", "t": "V", "term": true}, "Key": {"v": "Touche", "t": "V", "term": true, "forms": {"f1": "touches"}}, "Door": {"v": "Porte", "t": "V", "term": true}}, "text": "la couleur d'porte", "source": "A Door"},
      "out": {"v": "la couleur d'[!g*0]", "links": [{"to": "Door", "by": "A", "was": "porte", "case": "lower-first"}], "not_found": [], "problem": null},
      "why": "the apostrophe, like the space, ends a word" },
    { "id": "link_finding/find/a-digit-stuck-to-the-writing", "op": "find",
      "in": {"terms": {"Star Coin": {"v": "Pièce d'étoile", "t": "V", "term": true, "forms": {"f1": "pièces d'étoile", "f2": "de la pièce d'étoile"}}, "Coin": {"v": "Pièce", "t": "V", "term": true}, "Key": {"v": "Touche", "t": "V", "term": true, "forms": {"f1": "touches"}}, "Door": {"v": "Porte", "t": "V", "term": true}}, "text": "touche2 et 2touche", "source": "Key card"},
      "out": {"v": "touche2 et 2touche", "links": [], "not_found": []},
      "why": "a digit stuck to a letter is the same word" },
    { "id": "link_finding/find/a-mark-after-the-last-letter", "op": "find",
      "in": {"terms": {"Star Coin": {"v": "Pièce d'étoile", "t": "V", "term": true, "forms": {"f1": "pièces d'étoile", "f2": "de la pièce d'étoile"}}, "Coin": {"v": "Pièce", "t": "V", "term": true}, "Key": {"v": "Touche", "t": "V", "term": true, "forms": {"f1": "touches"}}, "Door": {"v": "Porte", "t": "V", "term": true}}, "text": "une touché", "source": "Key card"},
      "out": {"v": "une touché", "links": [], "not_found": []},
      "why": "a combining mark after the last letter is part of the word: « touche » is not found in it" },
    { "id": "link_finding/find/a-no-break-space-is-an-edge", "op": "find",
      "in": {"terms": {"Star Coin": {"v": "Pièce d'étoile", "t": "V", "term": true, "forms": {"f1": "pièces d'étoile", "f2": "de la pièce d'étoile"}}, "Coin": {"v": "Pièce", "t": "V", "term": true}, "Key": {"v": "Touche", "t": "V", "term": true, "forms": {"f1": "touches"}}, "Door": {"v": "Porte", "t": "V", "term": true}}, "text": "une touche", "source": "Key card"},
      "out": {"v": "une [!g*0]", "links": [{"to": "Key", "by": "A", "was": "touche", "case": "lower-first"}], "not_found": [], "problem": null},
      "why": "the no-break space is a space" },
    { "id": "link_finding/find/ideographs-stuck-to-latin", "op": "find",
      "in": {"terms": {"Star Coin": {"v": "Pièce d'étoile", "t": "V", "term": true, "forms": {"f1": "pièces d'étoile", "f2": "de la pièce d'étoile"}}, "Coin": {"v": "Pièce", "t": "V", "term": true}, "Key": {"v": "Touche", "t": "V", "term": true, "forms": {"f1": "touches"}}, "Door": {"v": "Porte", "t": "V", "term": true}}, "text": "日本touche日本", "source": "Key card"},
      "out": {"v": "日本[!g*0]日本", "links": [{"to": "Key", "by": "A", "was": "touche", "case": "lower-first"}], "not_found": [], "problem": null},
      "why": "an ideograph is no part of a spaced word: the Latin word stuck to it is an occurrence" },
    { "id": "link_finding/find/a-script-with-no-space-in-the-source", "op": "find",
      "in": {"terms": {"弟子": {"v": "Disciple", "t": "V", "term": true}, "外门弟子": {"v": "Disciple externe", "t": "V", "term": true}}, "text": "Disciple de la porte", "source": "外门弟子上"},
      "out": {"v": "Disciple de la porte", "links": [], "not_found": []},
      "why": "the longest term is cited (« Disciple externe » is not in the text): the shorter one is NOT cited, it is inside the longer" },
    { "id": "link_finding/find/the-longest-term-is-cited-first", "op": "find",
      "in": {"terms": {"弟子": {"v": "Disciple", "t": "V", "term": true}, "外门弟子": {"v": "Disciple externe", "t": "V", "term": true}}, "text": "Disciple externe de la porte", "source": "外门弟子上"},
      "out": {"v": "[!g*0] de la porte", "links": [{"to": "外门弟子", "by": "A", "was": "Disciple externe"}], "not_found": [], "problem": null},
      "why": "in a script with no spaces a term is found by containment, the longest first, never overlapping" },
    { "id": "link_finding/find/the-shorter-term-alone", "op": "find",
      "in": {"terms": {"弟子": {"v": "Disciple", "t": "V", "term": true}, "外门弟子": {"v": "Disciple externe", "t": "V", "term": true}}, "text": "Disciple de la porte", "source": "上弟子上"},
      "out": {"v": "[!g*0] de la porte", "links": [{"to": "弟子", "by": "A", "was": "Disciple"}], "not_found": [], "problem": null},
      "why": "cited alone, the shorter term is a link" },
    { "id": "link_finding/find/two-terms-one-inside-the-other", "op": "find",
      "in": {"terms": {"Star Coin": {"v": "Pièce d'étoile", "t": "V", "term": true, "forms": {"f1": "pièces d'étoile", "f2": "de la pièce d'étoile"}}, "Coin": {"v": "Pièce", "t": "V", "term": true}, "Key": {"v": "Touche", "t": "V", "term": true, "forms": {"f1": "touches"}}, "Door": {"v": "Porte", "t": "V", "term": true}}, "text": "une pièce d'étoile et une pièce", "source": "A Star Coin and a Coin"},
      "out": {"v": "une [!g*0] et une [!g*1]", "links": [{"to": "Star Coin", "by": "A", "was": "pièce d'étoile", "case": "lower-first"}, {"to": "Coin", "by": "A", "was": "pièce", "case": "lower-first"}], "not_found": [], "problem": null},
      "why": "the writing of « Coin » is inside the writing of « Star Coin »: the longest claims its place first, the shorter finds its OWN occurrence — which is then the only one left, so it is a link" },
    { "id": "link_finding/find/the-longest-writing-of-a-term-wins", "op": "find",
      "in": {"terms": {"Star Coin": {"v": "Pièce d'étoile", "t": "V", "term": true, "forms": {"f1": "pièces d'étoile", "f2": "de la pièce d'étoile"}}, "Coin": {"v": "Pièce", "t": "V", "term": true}, "Key": {"v": "Touche", "t": "V", "term": true, "forms": {"f1": "touches"}}, "Door": {"v": "Porte", "t": "V", "term": true}}, "text": "de la pièce d'étoile", "source": "A Star Coin"},
      "out": {"v": "[!g*0]", "links": [{"to": "Star Coin", "by": "A", "was": "de la pièce d'étoile", "form": "f2"}], "not_found": [], "problem": null},
      "why": "two writings of one term at the same place (« pièce d'étoile » is inside « de la pièce d'étoile »): the longer, once" },
    { "id": "link_finding/find/two-writings-at-two-places", "op": "find",
      "in": {"terms": {"Star Coin": {"v": "Pièce d'étoile", "t": "V", "term": true, "forms": {"f1": "pièces d'étoile", "f2": "de la pièce d'étoile"}}, "Coin": {"v": "Pièce", "t": "V", "term": true}, "Key": {"v": "Touche", "t": "V", "term": true, "forms": {"f1": "touches"}}, "Door": {"v": "Porte", "t": "V", "term": true}}, "text": "des pièces d'étoile et la pièce d'étoile", "source": "A Star Coin"},
      "out": {"v": "des pièces d'étoile et la pièce d'étoile", "links": [], "not_found": []},
      "why": "two places, whatever the writing: no link" },
    { "id": "link_finding/find/a-term-the-person-refused", "op": "find",
      "in": {"terms": {"Star Coin": {"v": "Pièce d'étoile", "t": "V", "term": true, "forms": {"f1": "pièces d'étoile", "f2": "de la pièce d'étoile"}}, "Coin": {"v": "Pièce", "t": "V", "term": true}, "Key": {"v": "Touche", "t": "V", "term": true, "forms": {"f1": "touches"}}, "Door": {"v": "Porte", "t": "V", "term": true}}, "text": "une touche", "source": "Key card", "before": {"v": "une touche", "t": "A", "unlinked": [{"to": "Key"}]}},
      "out": {"v": "une touche", "links": [], "not_found": []},
      "why": "a term the line refuses (`unlinked`) is never proposed again" },
    { "id": "link_finding/find/the-source-is-a-term", "op": "find",
      "in": {"terms": {"Star Coin": {"v": "Pièce d'étoile", "t": "V", "term": true, "forms": {"f1": "pièces d'étoile", "f2": "de la pièce d'étoile"}}, "Coin": {"v": "Pièce", "t": "V", "term": true}, "Key": {"v": "Touche", "t": "V", "term": true, "forms": {"f1": "touches"}}, "Door": {"v": "Porte", "t": "V", "term": true}}, "text": "touche", "source": "Key"},
      "out": {"v": "touche", "links": [], "not_found": []},
      "why": "a term's own line is not a sentence: no link" },
    { "id": "link_finding/find/a-link-marker-in-the-text", "op": "find",
      "in": {"terms": {"Star Coin": {"v": "Pièce d'étoile", "t": "V", "term": true, "forms": {"f1": "pièces d'étoile", "f2": "de la pièce d'étoile"}}, "Coin": {"v": "Pièce", "t": "V", "term": true}, "Key": {"v": "Touche", "t": "V", "term": true, "forms": {"f1": "touches"}}, "Door": {"v": "Porte", "t": "V", "term": true}}, "text": "une [!g*0]", "source": "Key card"},
      "out": {"v": "une [!g*0]", "links": [], "not_found": [], "problem": "text-has-link-marker"},
      "why": "the text must be clear: a marker is refused, never read" },
    { "id": "link_finding/find/no-term-no-work", "op": "find",
      "in": {"terms": {}, "text": "une touche", "source": "Key card"},
      "out": {"v": "une touche", "links": [], "not_found": []},
      "why": "a file with no term: the text comes back as it is" },
    { "id": "link_finding/find/a-persons-link-is-kept", "op": "find",
      "in": {"terms": {"Star Coin": {"v": "Pièce d'étoile", "t": "V", "term": true, "forms": {"f1": "pièces d'étoile", "f2": "de la pièce d'étoile"}}, "Coin": {"v": "Pièce", "t": "V", "term": true}, "Key": {"v": "Touche", "t": "V", "term": true, "forms": {"f1": "touches"}}, "Door": {"v": "Porte", "t": "V", "term": true}}, "text": "une touche rouge", "source": "A red Key", "before": {"v": "une [!g*0] rouge", "t": "H", "links": [{"to": "Key", "by": "H", "was": "touche", "case": "lower-first"}]}},
      "out": {"v": "une [!g*0] rouge", "links": [{"to": "Key", "by": "H", "was": "touche", "case": "lower-first"}], "not_found": [], "problem": null},
      "why": "a link a person set whose exact words are found once stays hers (`by: H`); the machine does not link the same term again" },
    { "id": "link_finding/find/a-persons-own-writing-is-found-by-its-text", "op": "find",
      "in": {"terms": {"Star Coin": {"v": "Pièce d'étoile", "t": "V", "term": true, "forms": {"f1": "pièces d'étoile", "f2": "de la pièce d'étoile"}}, "Coin": {"v": "Pièce", "t": "V", "term": true}, "Key": {"v": "Touche", "t": "V", "term": true, "forms": {"f1": "touches"}}, "Door": {"v": "Porte", "t": "V", "term": true}}, "text": "des touches rouges ici", "source": "red Keys here, Key", "before": {"v": "des [!g*0] ici", "t": "H", "links": [{"to": "Key", "by": "H", "was": "touches rouges", "form": "f1", "own": "touches rouges"}]}},
      "out": {"v": "des [!g*0] ici", "links": [{"to": "Key", "by": "H", "was": "touches rouges", "form": "f1", "own": "touches rouges"}], "not_found": [], "problem": null},
      "why": "the sentence's own writing is looked for as itself" },
    { "id": "link_finding/find/a-persons-link-that-is-gone-is-named", "op": "find",
      "in": {"terms": {"Star Coin": {"v": "Pièce d'étoile", "t": "V", "term": true, "forms": {"f1": "pièces d'étoile", "f2": "de la pièce d'étoile"}}, "Coin": {"v": "Pièce", "t": "V", "term": true}, "Key": {"v": "Touche", "t": "V", "term": true, "forms": {"f1": "touches"}}, "Door": {"v": "Porte", "t": "V", "term": true}}, "text": "une clé", "source": "Key card", "before": {"v": "une [!g*0]", "t": "H", "links": [{"to": "Key", "by": "H", "was": "touche", "case": "lower-first"}]}},
      "out": {"v": "une clé", "links": [], "not_found": [{"to": "Key", "by": "H", "was": "touche", "case": "lower-first"}], "problem": null},
      "why": "its words are no longer in the text: it is NAMED, to be shown before she accepts — accepting drops it" },
    { "id": "link_finding/find/a-persons-link-found-twice-is-named", "op": "find",
      "in": {"terms": {"Star Coin": {"v": "Pièce d'étoile", "t": "V", "term": true, "forms": {"f1": "pièces d'étoile", "f2": "de la pièce d'étoile"}}, "Coin": {"v": "Pièce", "t": "V", "term": true}, "Key": {"v": "Touche", "t": "V", "term": true, "forms": {"f1": "touches"}}, "Door": {"v": "Porte", "t": "V", "term": true}}, "text": "touche et touche", "source": "Key card", "before": {"v": "[!g*0] et x", "t": "H", "links": [{"to": "Key", "by": "H", "was": "touche"}]}},
      "out": {"v": "touche et touche", "links": [], "not_found": [{"to": "Key", "by": "H", "was": "touche"}], "problem": null},
