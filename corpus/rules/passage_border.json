{
  "rule": "passage_border",
  "classes": ["PassageBorder"],
  "note": "THE border rule and its companions, in one place (PassageBorder): which differences touch a linked passage; which reach outside it; whether it stays OPEN for the next keystroke; which writing a changed passage is widened to. The default of 2026-11-13: a difference stuck to the edge is OUTSIDE the passage; the user's opinion is pending, and changing it is changing these cases and the four methods, nothing else.",
  "operations": {
    "touches": {"in": {"hunk_start": "int", "hunk_end": "int", "passage_start": "int", "passage_end": "int", "open": "bool"}, "out": "bool"},
    "straddles": {"in": "same", "out": "bool: it touches AND reaches outside the passage"},
    "stays_open": {"in": "same", "out": "bool: it touched, and reached the passage's end"},
    "absorbed_at": {"in": {"text": "string", "start": "int", "end": "int", "writing": "string"}, "out": "int: the leftmost occurrence of the writing that contains [start, end), or -1"}
  },
  "cases": [
    { "id": "passage_border/touches/insertion-at-the-start", "op": "touches",
      "in": {"hunk_start": 5, "hunk_end": 5, "passage_start": 5, "passage_end": 10, "open": false},
      "out": false,
      "why": "text typed right before a passage is outside it" },
    { "id": "passage_border/touches/insertion-at-the-end", "op": "touches",
      "in": {"hunk_start": 10, "hunk_end": 10, "passage_start": 5, "passage_end": 10, "open": false},
      "out": false,
      "why": "and right after it too: the border rule" },
    { "id": "passage_border/touches/insertion-inside", "op": "touches",
      "in": {"hunk_start": 7, "hunk_end": 7, "passage_start": 5, "passage_end": 10, "open": false},
      "out": true,
      "why": "strictly inside, it is part of the passage" },
    { "id": "passage_border/touches/deletion-ending-at-the-start", "op": "touches",
      "in": {"hunk_start": 3, "hunk_end": 5, "passage_start": 5, "passage_end": 10, "open": false},
      "out": false,
      "why": "a deletion that stops where the passage begins does not touch it" },
    { "id": "passage_border/touches/deletion-starting-at-the-end", "op": "touches",
      "in": {"hunk_start": 10, "hunk_end": 12, "passage_start": 5, "passage_end": 10, "open": false},
      "out": false,
      "why": "nor one that starts where it ends" },
    { "id": "passage_border/touches/deletion-overlapping-the-start", "op": "touches",
      "in": {"hunk_start": 4, "hunk_end": 6, "passage_start": 5, "passage_end": 10, "open": false},
      "out": true,
      "why": "one character of overlap is enough" },
    { "id": "passage_border/touches/replacement-inside", "op": "touches",
      "in": {"hunk_start": 6, "hunk_end": 8, "passage_start": 5, "passage_end": 10, "open": false},
      "out": true,
      "why": "inside" },
    { "id": "passage_border/touches/replacement-of-the-passage", "op": "touches",
      "in": {"hunk_start": 5, "hunk_end": 10, "passage_start": 5, "passage_end": 10, "open": false},
      "out": true,
      "why": "exactly the passage" },
    { "id": "passage_border/touches/open-insertion-at-the-end", "op": "touches",
      "in": {"hunk_start": 10, "hunk_end": 10, "passage_start": 5, "passage_end": 10, "open": true},
      "out": true,
      "why": "an OPEN passage takes what is typed at its end: retyping it letter by letter" },
    { "id": "passage_border/touches/open-insertion-at-the-start", "op": "touches",
      "in": {"hunk_start": 5, "hunk_end": 5, "passage_start": 5, "passage_end": 10, "open": true},
      "out": false,
      "why": "open is about the END only" },
    { "id": "passage_border/touches/open-insertion-after-the-end", "op": "touches",
      "in": {"hunk_start": 11, "hunk_end": 11, "passage_start": 5, "passage_end": 10, "open": true},
      "out": false,
      "why": "and about the very end, not a place after it" },
    { "id": "passage_border/straddles/overlapping-the-start-straddles", "op": "straddles",
      "in": {"hunk_start": 4, "hunk_end": 6, "passage_start": 5, "passage_end": 10, "open": false},
      "out": true,
      "why": "it covers a word before the passage too" },
    { "id": "passage_border/straddles/overlapping-the-end-straddles", "op": "straddles",
      "in": {"hunk_start": 9, "hunk_end": 12, "passage_start": 5, "passage_end": 10, "open": false},
      "out": true,
      "why": "or after" },
    { "id": "passage_border/straddles/inside-does-not-straddle", "op": "straddles",
      "in": {"hunk_start": 6, "hunk_end": 8, "passage_start": 5, "passage_end": 10, "open": false},
      "out": false,
      "why": "a change within the passage is the passage changing" },
    { "id": "passage_border/straddles/the-passage-itself-does-not-straddle", "op": "straddles",
      "in": {"hunk_start": 5, "hunk_end": 10, "passage_start": 5, "passage_end": 10, "open": false},
      "out": false,
      "why": "replacing exactly the words of the passage" },
    { "id": "passage_border/straddles/covering-more-straddles", "op": "straddles",
      "in": {"hunk_start": 3, "hunk_end": 12, "passage_start": 5, "passage_end": 10, "open": false},
      "out": true,
      "why": "a selection that covers the passage and words around it" },
    { "id": "passage_border/straddles/an-insertion-never-straddles", "op": "straddles",
      "in": {"hunk_start": 7, "hunk_end": 7, "passage_start": 5, "passage_end": 10, "open": false},
      "out": false,
      "why": "nothing is replaced" },
    { "id": "passage_border/straddles/an-open-insertion-never-straddles", "op": "straddles",
      "in": {"hunk_start": 10, "hunk_end": 10, "passage_start": 5, "passage_end": 10, "open": true},
      "out": false,
      "why": "nor at the end of an open passage" },
    { "id": "passage_border/straddles/outside-does-not-straddle", "op": "straddles",
      "in": {"hunk_start": 0, "hunk_end": 3, "passage_start": 5, "passage_end": 10, "open": false},
      "out": false,
      "why": "it does not touch" },
    { "id": "passage_border/stays_open/erasing-the-tail-leaves-it-open", "op": "stays_open",
      "in": {"hunk_start": 8, "hunk_end": 10, "passage_start": 5, "passage_end": 10, "open": false},
      "out": true,
      "why": "the hunk reached the end of the passage: the next characters typed there are its own" },
    { "id": "passage_border/stays_open/retyping-the-whole-passage-leaves-it-open", "op": "stays_open",
      "in": {"hunk_start": 5, "hunk_end": 10, "passage_start": 5, "passage_end": 10, "open": false},
      "out": true,
      "why": "a selection retyped" },
    { "id": "passage_border/stays_open/typing-at-the-end-of-an-open-one-keeps-it-open", "op": "stays_open",
      "in": {"hunk_start": 10, "hunk_end": 10, "passage_start": 5, "passage_end": 10, "open": true},
      "out": true,
      "why": "letter after letter" },
    { "id": "passage_border/stays_open/a-change-in-the-middle-does-not", "op": "stays_open",
      "in": {"hunk_start": 6, "hunk_end": 8, "passage_start": 5, "passage_end": 10, "open": false},
      "out": false,
      "why": "it did not reach the end" },
    { "id": "passage_border/stays_open/typing-inside-does-not", "op": "stays_open",
      "in": {"hunk_start": 7, "hunk_end": 7, "passage_start": 5, "passage_end": 10, "open": false},
      "out": false,
      "why": "strictly inside" },
    { "id": "passage_border/stays_open/a-change-elsewhere-does-not", "op": "stays_open",
      "in": {"hunk_start": 0, "hunk_end": 2, "passage_start": 5, "passage_end": 10, "open": false},
      "out": false,
      "why": "it does not even touch" },
    { "id": "passage_border/absorbed_at/a-writing-that-contains-the-words", "op": "absorbed_at",
      "in": {"text": "Pas assez de de la pièce d'étoile !", "start": 19, "end": 33, "writing": "de la pièce d'étoile"},
      "out": 13,
      "why": "« pièce d'étoile » sits inside « de la pièce d'étoile »: the words typed in front complete the writing" },
    { "id": "passage_border/absorbed_at/the-writing-itself", "op": "absorbed_at",
      "in": {"text": "xabcx", "start": 1, "end": 4, "writing": "abc"},
      "out": 1,
      "why": "the words are the writing" },
    { "id": "passage_border/absorbed_at/a-writing-that-does-not-contain-them", "op": "absorbed_at",
      "in": {"text": "Pas assez de gemmes !", "start": 13, "end": 19, "writing": "pièces d'étoile"},
      "out": -1,
      "why": "no occurrence" },
    { "id": "passage_border/absorbed_at/shorter-than-the-words", "op": "absorbed_at",
      "in": {"text": "Pas assez de pièces d'étoile !", "start": 13, "end": 28, "writing": "pièces"},
      "out": -1,
      "why": "a writing shorter than the words cannot contain them" },
    { "id": "passage_border/absorbed_at/the-occurrence-must-cover-the-words", "op": "absorbed_at",
      "in": {"text": "de la pièce d'étoile et pièce d'étoile", "start": 28, "end": 38, "writing": "de la pièce d'étoile"},
      "out": -1,
