{
  "rule": "line_markers",
  "classes": ["LineMarkers"],
  "note": "The grammar of the three markers the format 2 adds to the text of a line, as spec/translation-file/schema.json `x-markers` writes it. Grammar only: what a marker MEANS is rules/link_reading.json and rules/line_writes.json. A port reads the same three patterns; a marker is never recognised by a looser rule (« [!note] » is the game's text).",
  "operations": {
    "link_numbers": {"in": {"text": "string?"}, "out": "the N of every [!g*N], in reading order"},
    "closed_slots": {"in": {"text": "string?"}, "out": "[{list, repeated, agrees}] — agrees is null or the text after ="},
    "open_slots": {"in": {"text": "string?"}, "out": "the N of every [!T*N], in reading order"},
    "open_slot_ref": {"in": {"agrees": "string?"}, "out": "N when the text is T then a canonical number, else -1"}
  },
  "cases": [
    { "id": "line_markers/link_numbers/two-links", "op": "link_numbers",
      "in": {"text": "Pas assez de [!g*0] et de [!g*1] !"},
      "out": [0, 1],
      "why": "every [!g*N] is read, in reading order" },
    { "id": "line_markers/link_numbers/same-link-twice", "op": "link_numbers",
      "in": {"text": "[!g*0] puis [!g*0]"},
      "out": [0, 0],
      "why": "a repeated marker is listed as many times as it is written: one link may be shown twice" },
    { "id": "line_markers/link_numbers/no-marker", "op": "link_numbers",
      "in": {"text": "Bonjour"},
      "out": [],
      "why": "plain text holds none" },
    { "id": "line_markers/link_numbers/leading-zero-is-not-a-marker", "op": "link_numbers",
      "in": {"text": "[!g*01]"},
      "out": [],
      "why": "N is canonical: [!g*01] never points at links[1]" },
    { "id": "line_markers/link_numbers/ten-digits-is-not-a-marker", "op": "link_numbers",
      "in": {"text": "[!g*1234567890]"},
      "out": [],
      "why": "N is at most nine digits" },
    { "id": "line_markers/link_numbers/other-markers-are-not-links", "op": "link_numbers",
      "in": {"text": "[!v*0] [!t*0] [!STR*0] [!nl] [!G*0] [!g*] [!g*a] [!note]"},
      "out": [],
      "why": "only [!g*N]: another marker, another case of the letter, no number — all are text" },
    { "id": "line_markers/link_numbers/null-text", "op": "link_numbers",
      "in": {"text": null},
      "out": [],
      "why": "no text, no marker" },
    { "id": "line_markers/closed_slots/slot-one-list", "op": "closed_slots",
      "in": {"text": "[!L*weapon]"},
      "out": [{"list": "weapon", "repeated": false, "agrees": null}],
      "why": "a closed slot names a list" },
    { "id": "line_markers/closed_slots/slots-in-order", "op": "closed_slots",
      "in": {"text": "[!L*quality][!L*weapon]"},
      "out": [{"list": "quality", "repeated": false, "agrees": null}, {"list": "weapon", "repeated": false, "agrees": null}],
      "why": "in reading order" },
    { "id": "line_markers/closed_slots/slot-repeated", "op": "closed_slots",
      "in": {"text": "[!L*given*]"},
      "out": [{"list": "given", "repeated": true, "agrees": null}],
      "why": "a star ends the name: one or more entries, glued" },
    { "id": "line_markers/closed_slots/slot-agrees-with-a-list", "op": "closed_slots",
      "in": {"text": "[!L*quality=weapon]"},
      "out": [{"list": "quality", "repeated": false, "agrees": "weapon"}],
      "why": "= names the slot whose entry imposes the form" },
    { "id": "line_markers/closed_slots/slot-agrees-with-an-open-slot", "op": "closed_slots",
      "in": {"text": "[!T*0][!L*affix*=T0]"},
      "out": [{"list": "affix", "repeated": true, "agrees": "T0"}],
      "why": "repeated and agreeing, the reference being an open slot" },
    { "id": "line_markers/closed_slots/slot-dotted-name", "op": "closed_slots",
      "in": {"text": "[!L*HeroData.heroName]"},
      "out": [{"list": "HeroData.heroName", "repeated": false, "agrees": null}],
      "why": "a list name is the game's own: dots and capitals stay" },
    { "id": "line_markers/closed_slots/slot-with-a-colon-is-not-a-slot", "op": "closed_slots",
      "in": {"text": "[!L*rank:lower]"},
      "out": [],
      "why": "the prototype's `:form` suffix is not the format 2's grammar: it is no marker here" },
    { "id": "line_markers/closed_slots/slot-without-a-name", "op": "closed_slots",
      "in": {"text": "[!L*] [!L**] [!l*a]"},
      "out": [],
      "why": "no name, no marker; and the letter is capital" },
    { "id": "line_markers/closed_slots/slot-name-stops-at-brackets", "op": "closed_slots",
      "in": {"text": "[!L*a[!L*b]"},
      "out": [{"list": "b", "repeated": false, "agrees": null}],
      "why": "a name holds no [ : an unclosed one is text and the next marker is read on its own" },
    { "id": "line_markers/open_slots/open-slots", "op": "open_slots",
      "in": {"text": "[!T*0] [!T*12]"},
      "out": [0, 12],
      "why": "every [!T*N], in order" },
    { "id": "line_markers/open_slots/open-slot-not-a-number", "op": "open_slots",
      "in": {"text": "[!T*x] [!T*] [!t*0]"},
      "out": [],
      "why": "only a canonical number, only a capital T" },
    { "id": "line_markers/open_slot_ref/ref-open", "op": "open_slot_ref",
      "in": {"agrees": "T0"},
      "out": 0,
      "why": "T then a number names an open slot" },
    { "id": "line_markers/open_slot_ref/ref-open-twelve", "op": "open_slot_ref",
      "in": {"agrees": "T12"},
      "out": 12,
      "why": "any canonical number" },
    { "id": "line_markers/open_slot_ref/ref-list", "op": "open_slot_ref",
      "in": {"agrees": "weapon"},
      "out": -1,
      "why": "a list name is not an open slot" },
    { "id": "line_markers/open_slot_ref/ref-leading-zero", "op": "open_slot_ref",
      "in": {"agrees": "T01"},
      "out": -1,
      "why": "canonical numbers only" },
    { "id": "line_markers/open_slot_ref/ref-bare-t", "op": "open_slot_ref",
      "in": {"agrees": "T"},
      "out": -1,
      "why": "no number" },
    { "id": "line_markers/open_slot_ref/ref-null", "op": "open_slot_ref",
      "in": {"agrees": null},
      "out": -1,
      "why": "agreeing with nothing is not agreeing with an open slot" }
  ]
}
