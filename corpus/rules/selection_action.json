{
 "rule": "selection_action",
 "classes": [
  "SelectionAction"
 ],
 "note": "What a selection in a KEY (the game's text) can do: open the term the words are (or are the citation of), make one of them, or nothing \u2014 never a path that ends in a refusal. `terms` are the keys of the file's terms; `file` the lines, by key. The words are taken as a whole: a plural is not looked up as its singular.",
 "operations": {
  "for": {
   "in": {
    "words": "string",
    "file": "{key: line}",
    "file_format": "int",
    "terms": "[key]"
   },
   "out": "{action: open-term | new-term, key, existing?} | null"
  }
 },
 "cases": [
  {
   "id": "selection_action/for/words-that-are-a-term-open-that-term",
   "op": "for",
   "in": {
    "words": "Star Coin",
    "file": {
     "Star Coin": {
      "v": "Pi\u00e8ce d'\u00e9toile",
      "t": "V",
      "term": true
     },
     "Play": {
      "v": "Jouer",
      "t": "A"
     },
     "Found [!g*0]": {
      "v": "x",
      "t": "A"
     },
     "Not enough Star Coins!": {
      "v": "Pas assez de [!g*0] !",
      "t": "A",
      "links": [
       {
        "to": "Star Coin",
        "by": "A",
        "was": "x"
       }
      ]
     },
     "Marked": {
      "v": "Marqu\u00e9 [!g*0]",
      "t": "A"
     }
    },
    "file_format": 2,
    "terms": [
     "Star Coin"
    ]
   },
   "out": {
    "action": "open-term",
    "key": "Star Coin"
   },
   "why": "the window to open is the term's"
  },
