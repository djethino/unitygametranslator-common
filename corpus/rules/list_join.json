{
  "rule": "list_join",
  "classes": ["ListJoin"],
  "note": "How the entries of a game's list are joined when no text holds them (spec/translation-file/lists.md): `join` is the text between two entries, `join_case` the case of the first letter of each entry after the first (`lower-first` / `upper-first`, the vocabulary of a link's `case`; absent = capitals kept). The case is Casing's, never the runtime's. An empty entry gives nothing. A reader meeting an unknown `join_case` keeps the capitals; a writer owes one of the two values.",
  "operations": {
    "join": {"in": {"entries": "[string or null]", "between": "string or absent", "join_case": "string or absent"}, "out": "string: the name"},
    "is_case": {"in": {"join_case": "string or absent"}, "out": "bool: a value a writer may write"}
  },
  "cases": [
    { "id": "list_join/join/a-name-drawn-from-two-entries", "op": "join",
      "in": {"entries": ["Tu", "Quan"], "between": "", "join_case": "lower-first"},
      "out": "Tuquan",
      "why": "the entry after the first starts with a small letter: « Tuquan », not « TuQuan » — the case measured on a game's drawn names" },
    { "id": "list_join/join/without-a-case-the-capitals-stay", "op": "join",
      "in": {"entries": ["Tu", "Quan"], "between": ""},
      "out": "TuQuan",
      "why": "join_case absent: every entry keeps its own first letter" },
    { "id": "list_join/join/upper-first-makes-a-capital", "op": "join",
      "in": {"entries": ["tu", "quan"], "between": "", "join_case": "upper-first"},
      "out": "tuQuan",
      "why": "the first entry is never touched, whatever the case asked" },
    { "id": "list_join/join/a-separator-goes-before-each-following-entry", "op": "join",
      "in": {"entries": ["Ma", "Li", "Ya"], "between": "-", "join_case": "lower-first"},
      "out": "Ma-li-ya",
      "why": "between is written before each entry after the first" },
    { "id": "list_join/join/a-space-between", "op": "join",
      "in": {"entries": ["Lao", "Tu", "Quan"], "between": " ", "join_case": "lower-first"},
      "out": "Lao tu quan",
      "why": "the separator is the file's text, a space as well as nothing" },
    { "id": "list_join/join/a-letter-outside-the-basic-plane", "op": "join",
      "in": {"entries": ["x", "𐐀y"], "between": "", "join_case": "lower-first"},
      "out": "x𐐨y",
      "why": "DESERET CAPITAL LETTER LONG I (U+10400) is two UTF-16 units: the whole code point moves, never half of it" },
    { "id": "list_join/join/sharp-s-takes-its-titlecase", "op": "join",
      "in": {"entries": ["x", "ßa"], "between": "", "join_case": "upper-first"},
      "out": "xSsa",
      "why": "Casing's rule, not the runtime's: « ß » has no capital, its titlecase is « Ss »" },
    { "id": "list_join/join/only-the-first-letter-moves", "op": "join",
      "in": {"entries": ["A", "BCD"], "between": "", "join_case": "lower-first"},
      "out": "AbCD",
      "why": "the rest of the entry is left as written" },
    { "id": "list_join/join/an-empty-entry-gives-nothing", "op": "join",
      "in": {"entries": ["Tu", "", "Quan"], "between": "-", "join_case": "lower-first"},
      "out": "Tu-quan",
      "why": "no separator for nothing: a name never holds two in a row" },
    { "id": "list_join/join/an-empty-first-entry-is-not-the-first", "op": "join",
      "in": {"entries": ["", "Tu", "Quan"], "between": "-", "join_case": "lower-first"},
      "out": "Tu-quan",
      "why": "the first entry WITH words is the one kept as written, and no separator starts the name" },
    { "id": "list_join/join/an-absent-entry-is-an-empty-one", "op": "join",
      "in": {"entries": ["Tu", null, "Quan"], "between": "", "join_case": "lower-first"},
      "out": "Tuquan",
      "why": "a null reads as an empty text" },
    { "id": "list_join/join/one-entry", "op": "join",
      "in": {"entries": ["Tu"], "between": "-", "join_case": "lower-first"},
      "out": "Tu",
      "why": "nothing to join: the entry as it is, no separator" },
    { "id": "list_join/join/no-entry", "op": "join",
      "in": {"entries": [], "between": "-", "join_case": "lower-first"},
      "out": "",
      "why": "an empty list is an empty name" },
    { "id": "list_join/join/a-script-without-case", "op": "join",
      "in": {"entries": ["劳", "土"], "between": "", "join_case": "lower-first"},
      "out": "劳土",
      "why": "a first character with no case is left as it is" },
    { "id": "list_join/join/no-separator-given", "op": "join",
      "in": {"entries": ["Tu", "Quan"], "join_case": "lower-first"},
      "out": "Tuquan",
      "why": "between absent is no text" },
    { "id": "list_join/join/a-case-this-version-does-not-know", "op": "join",
      "in": {"entries": ["Tu", "Quan"], "between": "", "join_case": "title-first"},
      "out": "TuQuan",
      "why": "a reader meets what a newer writer wrote: the capitals stay, the file is never refused" },
    { "id": "list_join/is_case/lower-first", "op": "is_case",
      "in": {"join_case": "lower-first"},
      "out": true,
      "why": "" },
    { "id": "list_join/is_case/upper-first", "op": "is_case",
      "in": {"join_case": "upper-first"},
      "out": true,
      "why": "" },
    { "id": "list_join/is_case/absent", "op": "is_case",
      "in": {},
      "out": false,
      "why": "a writer that has no case leaves the field out, it does not write null" },
    { "id": "list_join/is_case/an-unknown-value", "op": "is_case",
      "in": {"join_case": "title-first"},
      "out": false,
      "why": "what a writer owes: the two values of the vocabulary" },
    { "id": "list_join/is_case/the-wrong-case-of-a-word", "op": "is_case",
      "in": {"join_case": "Lower-First"},
      "out": false,
      "why": "exact, like a link's case" }
  ]
}
