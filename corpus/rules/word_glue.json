{
  "rule": "word_glue",
  "classes": ["WordGlue"],
  "note": "Where a word ends, for finding a term in a text (spec/translation-file/finding.md): an edge cuts a word when the character inside it and the one outside are BOTH written stuck together into words: a character is glued when it is a constituent of a word (Word_Break, UAX #29: ALetter, Hebrew_Letter, Numeric, Extend, Format, ExtendNumLet, ZWJ — WordGlue.WordBreakValues) AND its Line_Break class (UAX #14) is one of AI AK AL AP AS CM H2 H3 HL JL JT JV NU VF VI ZWJ (WordGlue.Classes: the project's decisions — no ideograph, kana or SA), at the project's Unicode version (WordGlue.UnicodeVersion, equal to the mod's). Everything else is an edge: spaces, punctuation, and every sign and symbol (# * < > = ☆).",
  "operations": {
    "is_glued": {"in": {"code_point": "int"}, "out": "bool"},
    "edge_before": {"in": {"text": "string", "index": "int (UTF-16)"}, "out": "bool: a word may begin at the index"},
    "edge_after": {"in": {"text": "string", "index": "int (UTF-16, exclusive end)"}, "out": "bool: a word may end just before the index"}
  },
  "cases": [
    { "id": "word_glue/is_glued/latin-letter", "op": "is_glued",
      "in": {"code_point": 97},
      "out": true,
      "why": "a letter of a script that spaces its words" },
    { "id": "word_glue/is_glued/digit", "op": "is_glued",
      "in": {"code_point": 49},
      "out": true,
      "why": "a digit is written stuck into the word it is in" },
    { "id": "word_glue/is_glued/underscore", "op": "is_glued",
      "in": {"code_point": 95},
      "out": true,
      "why": "the low line is a word constituent (UAX #29 ExtendNumLet): an identifier is one word, stuck" },
    { "id": "word_glue/is_glued/hyphen", "op": "is_glued",
      "in": {"code_point": 45},
      "out": false,
      "why": "the hyphen is an edge: « carte-clé » is two words for the finding" },
    { "id": "word_glue/is_glued/apostrophe", "op": "is_glued",
      "in": {"code_point": 39},
      "out": false,
      "why": "so is the apostrophe: « d'étoile »" },
    { "id": "word_glue/is_glued/space", "op": "is_glued",
      "in": {"code_point": 32},
      "out": false,
      "why": "a space" },
    { "id": "word_glue/is_glued/no-break-space", "op": "is_glued",
      "in": {"code_point": 160},
      "out": false,
      "why": "the no-break space too: it is a space" },
    { "id": "word_glue/is_glued/full-stop", "op": "is_glued",
      "in": {"code_point": 46},
      "out": false,
      "why": "punctuation" },
    { "id": "word_glue/is_glued/combining-mark", "op": "is_glued",
      "in": {"code_point": 769},
      "out": true,
      "why": "a mark belongs to the letter before it: it is part of the word" },
    { "id": "word_glue/is_glued/hebrew", "op": "is_glued",
      "in": {"code_point": 1488},
      "out": true,
      "why": "Hebrew spaces its words" },
    { "id": "word_glue/is_glued/arabic", "op": "is_glued",
      "in": {"code_point": 1576},
      "out": true,
      "why": "Arabic too" },
    { "id": "word_glue/is_glued/hangul", "op": "is_glued",
      "in": {"code_point": 54620},
      "out": true,
      "why": "Hangul syllables are written stuck into spaced words" },
    { "id": "word_glue/is_glued/devanagari", "op": "is_glued",
      "in": {"code_point": 2325},
      "out": true,
      "why": "a Brahmic letter" },
    { "id": "word_glue/is_glued/virama", "op": "is_glued",
      "in": {"code_point": 2381},
      "out": true,
      "why": "a virama belongs to its consonant" },
    { "id": "word_glue/is_glued/astral-letter", "op": "is_glued",
      "in": {"code_point": 66600},
      "out": true,
      "why": "a letter outside the basic plane is one character" },
    { "id": "word_glue/is_glued/ideograph", "op": "is_glued",
