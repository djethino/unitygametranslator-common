{
  "rule": "word_glue",
  "classes": ["WordGlue"],
  "note": "Where a word ends, for finding a term in a text (spec/translation-file/finding.md): an edge cuts a word when the character inside it and the one outside are BOTH written stuck together into words — Unicode's line breaking classes AI AK AL AP AS CM H2 H3 HL JL JT JV NU VF VI ZWJ (WordGlue.Classes), at the project's Unicode version (WordGlue.UnicodeVersion, equal to the mod's). Everything else is an edge.",
  "operations": {
    "is_glued": {"in": {"code_point": "int"}, "out": "bool"},
    "edge_before": {"in": {"text": "string", "index": "int (UTF-16)"}, "out": "bool: a word may begin at the index"},
    "edge_after": {"in": {"text": "string", "index": "int (UTF-16, exclusive end)"}, "out": "bool: a word may end just before the index"}
  },
  "cases": [
    { "id": "word_glue/is_glued/latin-letter", "op": "is_glued",
      "in": {"code_point": 97},
      "out": true,
      "why": "a letter of a script that spaces its words" },
    { "id": "word_glue/is_glued/digit", "op": "is_glued",
      "in": {"code_point": 49},
      "out": true,
      "why": "a digit is written stuck into the word it is in" },
    { "id": "word_glue/is_glued/underscore", "op": "is_glued",
      "in": {"code_point": 95},
      "out": true,
      "why": "Unicode files the low line with the letters for line breaking: stuck" },
    { "id": "word_glue/is_glued/hyphen", "op": "is_glued",
      "in": {"code_point": 45},
      "out": false,
      "why": "the hyphen is an edge: « carte-clé » is two words for the finding" },
    { "id": "word_glue/is_glued/apostrophe", "op": "is_glued",
      "in": {"code_point": 39},
      "out": false,
      "why": "so is the apostrophe: « d'étoile »" },
    { "id": "word_glue/is_glued/space", "op": "is_glued",
      "in": {"code_point": 32},
      "out": false,
      "why": "a space" },
    { "id": "word_glue/is_glued/no-break-space", "op": "is_glued",
      "in": {"code_point": 160},
      "out": false,
      "why": "the no-break space too: it is a space" },
    { "id": "word_glue/is_glued/full-stop", "op": "is_glued",
      "in": {"code_point": 46},
      "out": false,
      "why": "punctuation" },
    { "id": "word_glue/is_glued/combining-mark", "op": "is_glued",
      "in": {"code_point": 769},
      "out": true,
      "why": "a mark belongs to the letter before it: it is part of the word" },
    { "id": "word_glue/is_glued/hebrew", "op": "is_glued",
      "in": {"code_point": 1488},
      "out": true,
      "why": "Hebrew spaces its words" },
    { "id": "word_glue/is_glued/arabic", "op": "is_glued",
      "in": {"code_point": 1576},
      "out": true,
      "why": "Arabic too" },
    { "id": "word_glue/is_glued/hangul", "op": "is_glued",
      "in": {"code_point": 54620},
      "out": true,
      "why": "Hangul syllables are written stuck into spaced words" },
    { "id": "word_glue/is_glued/devanagari", "op": "is_glued",
      "in": {"code_point": 2325},
      "out": true,
      "why": "a Brahmic letter" },
    { "id": "word_glue/is_glued/virama", "op": "is_glued",
      "in": {"code_point": 2381},
      "out": true,
      "why": "a virama belongs to its consonant" },
    { "id": "word_glue/is_glued/astral-letter", "op": "is_glued",
      "in": {"code_point": 66600},
      "out": true,
      "why": "a letter outside the basic plane is one character" },
    { "id": "word_glue/is_glued/ideograph", "op": "is_glued",
      "in": {"code_point": 26085},
      "out": false,
      "why": "every position between ideographs is an edge" },
    { "id": "word_glue/is_glued/hiragana", "op": "is_glued",
      "in": {"code_point": 12363},
      "out": false,
      "why": "and between kana" },
    { "id": "word_glue/is_glued/thai", "op": "is_glued",
      "in": {"code_point": 3585},
      "out": false,
      "why": "Thai writes no space: no limit can be drawn" },
    { "id": "word_glue/is_glued/emoji", "op": "is_glued",
      "in": {"code_point": 128578},
      "out": false,
      "why": "a pictograph" },
    { "id": "word_glue/edge_before/inside-a-word", "op": "edge_before",
      "in": {"text": "abc", "index": 1},
      "out": false,
      "why": "between two letters: the middle of a word" },
    { "id": "word_glue/edge_before/start-of-text", "op": "edge_before",
      "in": {"text": "ab", "index": 0},
      "out": true,
      "why": "the start of a text is an edge" },
    { "id": "word_glue/edge_before/after-a-hyphen", "op": "edge_before",
      "in": {"text": "a-b", "index": 2},
      "out": true,
      "why": "a hyphen before: an edge" },
    { "id": "word_glue/edge_before/after-a-space", "op": "edge_before",
      "in": {"text": "a b", "index": 2},
      "out": true,
      "why": "a space before" },
    { "id": "word_glue/edge_before/after-an-apostrophe", "op": "edge_before",
      "in": {"text": "d'a", "index": 2},
      "out": true,
      "why": "an apostrophe before: « étoile » begins a word in « d'étoile »" },
    { "id": "word_glue/edge_before/after-a-digit", "op": "edge_before",
      "in": {"text": "a1b", "index": 2},
      "out": false,
      "why": "a digit stuck to a letter" },
    { "id": "word_glue/edge_before/between-ideographs", "op": "edge_before",
      "in": {"text": "日本", "index": 1},
      "out": true,
      "why": "any position in a script with no space" },
    { "id": "word_glue/edge_before/latin-after-an-ideograph", "op": "edge_before",
      "in": {"text": "日a", "index": 1},
      "out": true,
      "why": "a Latin word stuck to an ideograph: the ideograph is no word of the same kind" },
    { "id": "word_glue/edge_before/astral-letters", "op": "edge_before",
      "in": {"text": "a𐐨", "index": 1},
      "out": false,
      "why": "a pair of surrogates is one letter" },
    { "id": "word_glue/edge_before/end-of-text", "op": "edge_before",
      "in": {"text": "ab", "index": 2},
      "out": true,
      "why": "an index at the end is an edge too" },
    { "id": "word_glue/edge_after/inside-a-word", "op": "edge_after",
      "in": {"text": "abc", "index": 1},
      "out": false,
      "why": "between two letters" },
    { "id": "word_glue/edge_after/before-a-hyphen", "op": "edge_after",
      "in": {"text": "a-b", "index": 1},
      "out": true,
      "why": "a hyphen after: an edge" },
    { "id": "word_glue/edge_after/before-a-space", "op": "edge_after",
      "in": {"text": "a b", "index": 1},
      "out": true,
      "why": "a space after" },
    { "id": "word_glue/edge_after/mark-after-the-last-letter", "op": "edge_after",
      "in": {"text": "é", "index": 1},
      "out": false,
      "why": "a combining mark after the last letter is part of the word: the edge is after the mark" },
    { "id": "word_glue/edge_after/digit-after-a-letter", "op": "edge_after",
      "in": {"text": "a1", "index": 1},
      "out": false,
      "why": "a digit stuck to a letter" },
    { "id": "word_glue/edge_after/no-break-space", "op": "edge_after",
      "in": {"text": "a b", "index": 1},
      "out": true,
      "why": "the no-break space is an edge" },
    { "id": "word_glue/edge_after/between-kana", "op": "edge_after",
      "in": {"text": "かか", "index": 1},
      "out": true,
      "why": "any position in kana" },
    { "id": "word_glue/edge_after/thai", "op": "edge_after",
      "in": {"text": "กข", "index": 1},
      "out": true,
      "why": "Thai: every position" },
    { "id": "word_glue/edge_after/astral-letter-then-latin", "op": "edge_after",
      "in": {"text": "𐐨a", "index": 2},
      "out": false,
      "why": "the letter before the index is decoded as one character, not as its second half" }
  ]
}
