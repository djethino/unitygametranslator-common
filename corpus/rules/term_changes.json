{
  "rule": "term_changes",
  "classes": ["TermChanges"],
  "note": "Changing the word of a term, or one of its written forms: which lines use it and what the change does to each (draft §7). `after` is the term's line as it would be (null: the term goes); `lists` the game's lists (`_lists`). A line is a template when its key holds a closed slot, a sentence otherwise. Uses come back in the file's order. A sentence is to read again when its link no longer reads its `was` or its entry is gone; a template when a person validated it (H or V) and the text it makes changes — the last reading is a proposal, not yet decided.",
  "operations": {
    "impact": {"in": {"entry_key": "string", "lines": "{key: line}, in file order", "lists": "{name: [values]}", "after": "line | null"}, "out": "{uses: [{key, kind (Link|Template), text_changes, needs_review_after, source_after}], forms_to_redo: [form ids]}"}
  },
  "cases": [
    { "id": "term_changes/impact/term-without-a-link", "op": "impact",
      "in": {"entry_key": "Lonely", "lines": {"Lonely": {"v": "Seul", "t": "V", "term": true}, "Play": {"v": "Jouer", "t": "A"}}, "lists": {}, "after": {"v": "Solitaire", "t": "V", "term": true}},
      "out": {"uses": [], "forms_to_redo": []},
      "why": "a term nothing points at: changing it touches nothing" },
    { "id": "term_changes/impact/new-word-reaches-the-own-form-only", "op": "impact",
      "in": {"entry_key": "Star Coin", "lines": {"Star Coin": {"v": "Pièce d'étoile", "t": "V", "term": true, "forms": {"f1": "pièces d'étoile", "f2": "de la pièce d'étoile"}}, "Key": {"v": "Touche", "t": "V", "term": true}, "S1": {"v": "[!g*0]", "t": "A", "links": [{"to": "Star Coin", "by": "A", "was": "pièces d'étoile", "form": "f1"}]}, "S2": {"v": "[!g*0]", "t": "A", "links": [{"to": "Star Coin", "by": "A", "was": "de la pièce d'étoile", "form": "f2"}]}, "S3": {"v": "[!g*0]", "t": "A", "links": [{"to": "Star Coin", "by": "A", "was": "Pièce d'étoile"}]}, "S4": {"v": "[!g*0] [!g*1]", "t": "A", "links": [{"to": "Star Coin", "by": "A", "was": "pièces d'étoile", "form": "f1"}, {"to": "Star Coin", "by": "A", "was": "de la pièce d'étoile", "form": "f2"}]}, "S5": {"v": "[!g*0]", "t": "A", "links": [{"to": "Key", "by": "A", "was": "Touche"}]}}, "lists": {}, "after": {"v": "Pièce stellaire", "t": "V", "term": true, "forms": {"f1": "pièces d'étoile", "f2": "de la pièce d'étoile"}}},
      "out": {"uses": [{"key": "S1", "kind": "Link", "text_changes": false, "needs_review_after": false, "source_after": "Form"}, {"key": "S2", "kind": "Link", "text_changes": false, "needs_review_after": false, "source_after": "Form"}, {"key": "S3", "kind": "Link", "text_changes": true, "needs_review_after": true, "source_after": "Entry"}, {"key": "S4", "kind": "Link", "text_changes": false, "needs_review_after": false, "source_after": "Form"}], "forms_to_redo": ["f1", "f2"]},
      "why": "the term's own text moved: only the sentence that shows it as such changes (and is to read again); the sentences on a written form show that form still, and the forms themselves were derived from the old word: to redo" },
    { "id": "term_changes/impact/one-form-changes", "op": "impact",
      "in": {"entry_key": "Star Coin", "lines": {"Star Coin": {"v": "Pièce d'étoile", "t": "V", "term": true, "forms": {"f1": "pièces d'étoile", "f2": "de la pièce d'étoile"}}, "Key": {"v": "Touche", "t": "V", "term": true}, "S1": {"v": "[!g*0]", "t": "A", "links": [{"to": "Star Coin", "by": "A", "was": "pièces d'étoile", "form": "f1"}]}, "S2": {"v": "[!g*0]", "t": "A", "links": [{"to": "Star Coin", "by": "A", "was": "de la pièce d'étoile", "form": "f2"}]}, "S3": {"v": "[!g*0]", "t": "A", "links": [{"to": "Star Coin", "by": "A", "was": "Pièce d'étoile"}]}, "S4": {"v": "[!g*0] [!g*1]", "t": "A", "links": [{"to": "Star Coin", "by": "A", "was": "pièces d'étoile", "form": "f1"}, {"to": "Star Coin", "by": "A", "was": "de la pièce d'étoile", "form": "f2"}]}, "S5": {"v": "[!g*0]", "t": "A", "links": [{"to": "Key", "by": "A", "was": "Touche"}]}}, "lists": {}, "after": {"v": "Pièce d'étoile", "t": "V", "term": true, "forms": {"f1": "pièces stellaires", "f2": "de la pièce d'étoile"}}},
      "out": {"uses": [{"key": "S1", "kind": "Link", "text_changes": true, "needs_review_after": true, "source_after": "Form"}, {"key": "S2", "kind": "Link", "text_changes": false, "needs_review_after": false, "source_after": "Form"}, {"key": "S3", "kind": "Link", "text_changes": false, "needs_review_after": false, "source_after": "Entry"}, {"key": "S4", "kind": "Link", "text_changes": true, "needs_review_after": true, "source_after": "Form"}], "forms_to_redo": []},
      "why": "only the sentences that ask THAT form change — the one citing both forms too, once" },
    { "id": "term_changes/impact/two-forms-in-one-sentence", "op": "impact",
      "in": {"entry_key": "Star Coin", "lines": {"Star Coin": {"v": "Pièce d'étoile", "t": "V", "term": true, "forms": {"f1": "pièces d'étoile", "f2": "de la pièce d'étoile"}}, "Key": {"v": "Touche", "t": "V", "term": true}, "S1": {"v": "[!g*0]", "t": "A", "links": [{"to": "Star Coin", "by": "A", "was": "pièces d'étoile", "form": "f1"}]}, "S2": {"v": "[!g*0]", "t": "A", "links": [{"to": "Star Coin", "by": "A", "was": "de la pièce d'étoile", "form": "f2"}]}, "S3": {"v": "[!g*0]", "t": "A", "links": [{"to": "Star Coin", "by": "A", "was": "Pièce d'étoile"}]}, "S4": {"v": "[!g*0] [!g*1]", "t": "A", "links": [{"to": "Star Coin", "by": "A", "was": "pièces d'étoile", "form": "f1"}, {"to": "Star Coin", "by": "A", "was": "de la pièce d'étoile", "form": "f2"}]}, "S5": {"v": "[!g*0]", "t": "A", "links": [{"to": "Key", "by": "A", "was": "Touche"}]}}, "lists": {}, "after": {"v": "Pièce d'étoile", "t": "V", "term": true, "forms": {"f1": "pièces stellaires", "f2": "de la pièce stellaire"}}},
      "out": {"uses": [{"key": "S1", "kind": "Link", "text_changes": true, "needs_review_after": true, "source_after": "Form"}, {"key": "S2", "kind": "Link", "text_changes": true, "needs_review_after": true, "source_after": "Form"}, {"key": "S3", "kind": "Link", "text_changes": false, "needs_review_after": false, "source_after": "Entry"}, {"key": "S4", "kind": "Link", "text_changes": true, "needs_review_after": true, "source_after": "Form"}], "forms_to_redo": []},
      "why": "a sentence with two links to one term is ONE line to read, listed once" },
    { "id": "term_changes/impact/form-removed-falls-back-to-the-word", "op": "impact",
      "in": {"entry_key": "Star Coin", "lines": {"Star Coin": {"v": "Pièce d'étoile", "t": "V", "term": true, "forms": {"f1": "pièces d'étoile", "f2": "de la pièce d'étoile"}}, "Key": {"v": "Touche", "t": "V", "term": true}, "S1": {"v": "[!g*0]", "t": "A", "links": [{"to": "Star Coin", "by": "A", "was": "pièces d'étoile", "form": "f1"}]}, "S2": {"v": "[!g*0]", "t": "A", "links": [{"to": "Star Coin", "by": "A", "was": "de la pièce d'étoile", "form": "f2"}]}, "S3": {"v": "[!g*0]", "t": "A", "links": [{"to": "Star Coin", "by": "A", "was": "Pièce d'étoile"}]}, "S4": {"v": "[!g*0] [!g*1]", "t": "A", "links": [{"to": "Star Coin", "by": "A", "was": "pièces d'étoile", "form": "f1"}, {"to": "Star Coin", "by": "A", "was": "de la pièce d'étoile", "form": "f2"}]}, "S5": {"v": "[!g*0]", "t": "A", "links": [{"to": "Key", "by": "A", "was": "Touche"}]}}, "lists": {}, "after": {"v": "Pièce d'étoile", "t": "V", "term": true, "forms": {"f2": "de la pièce d'étoile"}}},
      "out": {"uses": [{"key": "S1", "kind": "Link", "text_changes": true, "needs_review_after": true, "source_after": "Entry"}, {"key": "S2", "kind": "Link", "text_changes": false, "needs_review_after": false, "source_after": "Form"}, {"key": "S3", "kind": "Link", "text_changes": false, "needs_review_after": false, "source_after": "Entry"}, {"key": "S4", "kind": "Link", "text_changes": true, "needs_review_after": true, "source_after": "Entry"}], "forms_to_redo": []},
      "why": "a form that no longer exists reads the term's own text, never a hole — and the sentence is to read again" },
    { "id": "term_changes/impact/term-removed", "op": "impact",
      "in": {"entry_key": "Star Coin", "lines": {"Star Coin": {"v": "Pièce d'étoile", "t": "V", "term": true, "forms": {"f1": "pièces d'étoile", "f2": "de la pièce d'étoile"}}, "Key": {"v": "Touche", "t": "V", "term": true}, "S1": {"v": "[!g*0]", "t": "A", "links": [{"to": "Star Coin", "by": "A", "was": "pièces d'étoile", "form": "f1"}]}, "S2": {"v": "[!g*0]", "t": "A", "links": [{"to": "Star Coin", "by": "A", "was": "de la pièce d'étoile", "form": "f2"}]}, "S3": {"v": "[!g*0]", "t": "A", "links": [{"to": "Star Coin", "by": "A", "was": "Pièce d'étoile"}]}, "S4": {"v": "[!g*0] [!g*1]", "t": "A", "links": [{"to": "Star Coin", "by": "A", "was": "pièces d'étoile", "form": "f1"}, {"to": "Star Coin", "by": "A", "was": "de la pièce d'étoile", "form": "f2"}]}, "S5": {"v": "[!g*0]", "t": "A", "links": [{"to": "Key", "by": "A", "was": "Touche"}]}}, "lists": {}, "after": null},
      "out": {"uses": [{"key": "S1", "kind": "Link", "text_changes": false, "needs_review_after": true, "source_after": "Was"}, {"key": "S2", "kind": "Link", "text_changes": false, "needs_review_after": true, "source_after": "Was"}, {"key": "S3", "kind": "Link", "text_changes": false, "needs_review_after": true, "source_after": "Was"}, {"key": "S4", "kind": "Link", "text_changes": false, "needs_review_after": true, "source_after": "Was"}], "forms_to_redo": []},
      "why": "the term is gone: its sentences keep showing what they showed (`was`) and every one is to read again, whatever their text" },
    { "id": "term_changes/impact/an-unchanged-term-changes-nothing", "op": "impact",
      "in": {"entry_key": "Star Coin", "lines": {"Star Coin": {"v": "Pièce d'étoile", "t": "V", "term": true, "forms": {"f1": "pièces d'étoile", "f2": "de la pièce d'étoile"}}, "Key": {"v": "Touche", "t": "V", "term": true}, "S1": {"v": "[!g*0]", "t": "A", "links": [{"to": "Star Coin", "by": "A", "was": "pièces d'étoile", "form": "f1"}]}, "S2": {"v": "[!g*0]", "t": "A", "links": [{"to": "Star Coin", "by": "A", "was": "de la pièce d'étoile", "form": "f2"}]}, "S3": {"v": "[!g*0]", "t": "A", "links": [{"to": "Star Coin", "by": "A", "was": "Pièce d'étoile"}]}, "S4": {"v": "[!g*0] [!g*1]", "t": "A", "links": [{"to": "Star Coin", "by": "A", "was": "pièces d'étoile", "form": "f1"}, {"to": "Star Coin", "by": "A", "was": "de la pièce d'étoile", "form": "f2"}]}, "S5": {"v": "[!g*0]", "t": "A", "links": [{"to": "Key", "by": "A", "was": "Touche"}]}}, "lists": {}, "after": {"v": "Pièce d'étoile", "t": "V", "term": true, "forms": {"f1": "pièces d'étoile", "f2": "de la pièce d'étoile"}}},
      "out": {"uses": [{"key": "S1", "kind": "Link", "text_changes": false, "needs_review_after": false, "source_after": "Form"}, {"key": "S2", "kind": "Link", "text_changes": false, "needs_review_after": false, "source_after": "Form"}, {"key": "S3", "kind": "Link", "text_changes": false, "needs_review_after": false, "source_after": "Entry"}, {"key": "S4", "kind": "Link", "text_changes": false, "needs_review_after": false, "source_after": "Form"}], "forms_to_redo": []},
      "why": "saving a term as it stands touches no sentence" },
    { "id": "term_changes/impact/a-sentence-already-to-read-stays-so", "op": "impact",
      "in": {"entry_key": "Star Coin", "lines": {"Star Coin": {"v": "Pièce d'étoile", "t": "V", "term": true, "forms": {"f1": "pièces d'étoile", "f2": "de la pièce d'étoile"}}, "Old": {"v": "[!g*0]", "t": "A", "links": [{"to": "Star Coin", "by": "A", "was": "vieilles pièces", "form": "f1"}]}}, "lists": {}, "after": {"v": "Pièce stellaire", "t": "V", "term": true, "forms": {"f1": "pièces d'étoile", "f2": "de la pièce d'étoile"}}},
      "out": {"uses": [{"key": "Old", "kind": "Link", "text_changes": false, "needs_review_after": true, "source_after": "Form"}], "forms_to_redo": ["f1", "f2"]},
      "why": "its text does not change now, but it did not match its `was` before either: it is still to read" },
    { "id": "term_changes/impact/template-takes-a-changed-form", "op": "impact",
      "in": {"entry_key": "Star Coin", "lines": {"Star Coin": {"v": "Pièce d'étoile", "t": "V", "term": true, "forms": {"f1": "pièces d'étoile", "f2": "de la pièce d'étoile"}, "use": {"ta628c8a8ae06": "f1"}}, "Rusty": {"v": "Rouillé", "t": "A", "term": true}, "[!L*quality][!L*coin]": {"v": "[!L*coin] [!L*quality=coin]", "t": "A", "oracle": "accepted"}, "Other [!L*quality]": {"v": "x [!L*quality]", "t": "A"}}, "lists": {"quality": ["Rusty"], "coin": ["Star Coin"]}, "after": {"v": "Pièce d'étoile", "t": "V", "term": true, "forms": {"f1": "pièces stellaires", "f2": "de la pièce d'étoile"}, "use": {"ta628c8a8ae06": "f1"}}},
      "out": {"uses": [{"key": "[!L*quality][!L*coin]", "kind": "Template", "text_changes": true, "needs_review_after": false, "source_after": "Form"}], "forms_to_redo": []},
      "why": "a template of a list the term belongs to takes its form: the assembled text changes, and a machine's template is just assembled again; a template that reads another list is not a user" },
    { "id": "term_changes/impact/template-validated-by-a-person", "op": "impact",
      "in": {"entry_key": "Star Coin", "lines": {"Star Coin": {"v": "Pièce d'étoile", "t": "V", "term": true, "forms": {"f1": "pièces d'étoile", "f2": "de la pièce d'étoile"}, "use": {"ta628c8a8ae06": "f1"}}, "Rusty": {"v": "Rouillé", "t": "A", "term": true}, "[!L*quality][!L*coin]": {"v": "[!L*coin] [!L*quality=coin]", "t": "V", "oracle": "accepted"}, "Other [!L*quality]": {"v": "x [!L*quality]", "t": "A"}}, "lists": {"quality": ["Rusty"], "coin": ["Star Coin"]}, "after": {"v": "Pièce d'étoile", "t": "V", "term": true, "forms": {"f1": "pièces stellaires", "f2": "de la pièce d'étoile"}, "use": {"ta628c8a8ae06": "f1"}}},
      "out": {"uses": [{"key": "[!L*quality][!L*coin]", "kind": "Template", "text_changes": true, "needs_review_after": true, "source_after": "Form"}], "forms_to_redo": []},
      "why": "a person validated what this template made: when the text it makes changes, it is to read again" },
    { "id": "term_changes/impact/template-takes-the-own-text-by-default", "op": "impact",
      "in": {"entry_key": "Star Coin", "lines": {"Star Coin": {"v": "Pièce d'étoile", "t": "V", "term": true, "forms": {"f1": "pièces d'étoile", "f2": "de la pièce d'étoile"}}, "Rusty": {"v": "Rouillé", "t": "A", "term": true}, "[!L*quality][!L*coin]": {"v": "[!L*coin] [!L*quality=coin]", "t": "A", "oracle": "accepted"}, "Other [!L*quality]": {"v": "x [!L*quality]", "t": "A"}}, "lists": {"quality": ["Rusty"], "coin": ["Star Coin"]}, "after": {"v": "Pièce stellaire", "t": "V", "term": true, "forms": {"f1": "pièces d'étoile", "f2": "de la pièce d'étoile"}}},
      "out": {"uses": [{"key": "[!L*quality][!L*coin]", "kind": "Template", "text_changes": true, "needs_review_after": false, "source_after": "Form"}], "forms_to_redo": ["f1", "f2"]},
      "why": "no `use` for the template: it takes the term's own text, which moved" },
    { "id": "term_changes/impact/template-takes-another-form", "op": "impact",
      "in": {"entry_key": "Star Coin", "lines": {"Star Coin": {"v": "Pièce d'étoile", "t": "V", "term": true, "forms": {"f1": "pièces d'étoile", "f2": "de la pièce d'étoile"}, "use": {"ta628c8a8ae06": "f1"}}, "Rusty": {"v": "Rouillé", "t": "A", "term": true}, "[!L*quality][!L*coin]": {"v": "[!L*coin] [!L*quality=coin]", "t": "A", "oracle": "accepted"}, "Other [!L*quality]": {"v": "x [!L*quality]", "t": "A"}}, "lists": {"quality": ["Rusty"], "coin": ["Star Coin"]}, "after": {"v": "Pièce d'étoile", "t": "V", "term": true, "forms": {"f1": "pièces d'étoile", "f2": "de la pièce stellaire"}, "use": {"ta628c8a8ae06": "f1"}}},
      "out": {"uses": [{"key": "[!L*quality][!L*coin]", "kind": "Template", "text_changes": false, "needs_review_after": false, "source_after": "Form"}], "forms_to_redo": []},
      "why": "the template takes f1 and f2 changed: it is a user, and nothing changes for it" },
    { "id": "term_changes/impact/template-by-class-forms", "op": "impact",
      "in": {"entry_key": "Star Coin", "lines": {"Star Coin": {"v": "Pièce d'étoile", "t": "V", "term": true, "forms": {"f1": "pièces d'étoile", "f2": "de la pièce d'étoile"}, "use": {"ta628c8a8ae06": {"c0": "f1", "c1": "f2"}}}, "Rusty": {"v": "Rouillé", "t": "A", "term": true}, "[!L*quality][!L*coin]": {"v": "[!L*coin] [!L*quality=coin]", "t": "A", "oracle": "accepted"}, "Other [!L*quality]": {"v": "x [!L*quality]", "t": "A"}}, "lists": {"quality": ["Rusty"], "coin": ["Star Coin"]}, "after": {"v": "Pièce d'étoile", "t": "V", "term": true, "forms": {"f1": "pièces d'étoile", "f2": "de la pièce stellaire"}, "use": {"ta628c8a8ae06": {"c0": "f1", "c1": "f2"}}}},
      "out": {"uses": [{"key": "[!L*quality][!L*coin]", "kind": "Template", "text_changes": true, "needs_review_after": false, "source_after": "Form"}], "forms_to_redo": []},
      "why": "one form per class: any of them moving changes what the template can make" },
    { "id": "term_changes/impact/template-class-changes", "op": "impact",
      "in": {"entry_key": "Star Coin", "lines": {"Star Coin": {"v": "Pièce d'étoile", "t": "V", "term": true, "forms": {"f1": "pièces d'étoile", "f2": "de la pièce d'étoile"}, "class": {"ta628c8a8ae06": "c0"}}, "Rusty": {"v": "Rouillé", "t": "A", "term": true}, "[!L*quality][!L*coin]": {"v": "[!L*coin] [!L*quality=coin]", "t": "A", "oracle": "accepted"}, "Other [!L*quality]": {"v": "x [!L*quality]", "t": "A"}}, "lists": {"quality": ["Rusty"], "coin": ["Star Coin"]}, "after": {"v": "Pièce d'étoile", "t": "V", "term": true, "forms": {"f1": "pièces d'étoile", "f2": "de la pièce d'étoile"}, "class": {"ta628c8a8ae06": "c1"}}},
      "out": {"uses": [{"key": "[!L*quality][!L*coin]", "kind": "Template", "text_changes": true, "needs_review_after": false, "source_after": "Form"}], "forms_to_redo": []},
      "why": "the class a term gives in a template governs its neighbours' forms: changing it changes the text the template makes" },
    { "id": "term_changes/impact/term-removed-from-a-template", "op": "impact",
      "in": {"entry_key": "Star Coin", "lines": {"Star Coin": {"v": "Pièce d'étoile", "t": "V", "term": true, "forms": {"f1": "pièces d'étoile", "f2": "de la pièce d'étoile"}}, "Rusty": {"v": "Rouillé", "t": "A", "term": true}, "[!L*quality][!L*coin]": {"v": "[!L*coin] [!L*quality=coin]", "t": "A", "oracle": "accepted"}, "Other [!L*quality]": {"v": "x [!L*quality]", "t": "A"}}, "lists": {"quality": ["Rusty"], "coin": ["Star Coin"]}, "after": null},
      "out": {"uses": [{"key": "[!L*quality][!L*coin]", "kind": "Template", "text_changes": true, "needs_review_after": false, "source_after": "Form"}], "forms_to_redo": []},
      "why": "the term is gone: what the template made with it cannot be made" },
    { "id": "term_changes/impact/an-unchanged-term-with-a-capitalised-link", "op": "impact",
      "in": {"entry_key": "star coin", "lines": {"star coin": {"v": "pi\u00e8ce d'\u00e9toile", "t": "V", "term": true}, "S1": {"v": "[!g*0] brille.", "t": "A", "links": [{"to": "star coin", "by": "H", "case": "upper-first", "was": "Pi\u00e8ce d'\u00e9toile"}]}}, "lists": {}, "after": {"v": "pi\u00e8ce d'\u00e9toile", "t": "V", "term": true}},
      "out": {"uses": [{"key": "S1", "kind": "Link", "text_changes": false, "needs_review_after": false, "source_after": "Entry"}], "forms_to_redo": []},
