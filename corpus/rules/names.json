{
 "rule": "names",
 "classes": [
  "Names"
 ],
 "note": "How the NAMES of things (a game, a font, a sprite, a language, a file, a tag) are compared and ordered without caring about case: every code point is written as its simple capital, from the project's Unicode (UNICODE_VERSION, tools/generate-case-mapping.py), never the runtime's. The same answers and the same ORDER as .NET 8's OrdinalIgnoreCase wherever the runtime knows the letters (NamesChecks holds that over every code point); no bridge between ASCII and the rest. A text DECLARED ASCII (an extension, a digest, a code) goes through Ascii, not here. The order is by code point, NOT the UTF-16 code units of the content hash's keys.",
 "operations": {
  "fold": {
   "in": {
    "text": "string"
   },
   "out": "the text with every code point written as its simple capital"
  },
  "fold_code_point": {
   "in": {
    "code_point": "int"
   },
   "out": "its simple capital, or itself"
  },
  "equals": {
   "in": {
    "a": "string or null",
    "b": "string or null"
   },
   "out": "bool: the same name but for case"
  },
  "index_of": {
   "in": {
    "text": "string or null",
    "part": "string"
   },
   "out": "the UTF-16 index of the first place the part is found but for case, -1 when none"
  },
  "compare": {
   "in": {
    "a": "string or null",
    "b": "string or null"
   },
   "out": "the sign of the order: -1, 0 or 1"
  }
 },
 "cases": [
  {
   "id": "names/fold/ascii",
   "op": "fold",
   "in": {
    "text": "Hello_World 12"
   },
   "out": "HELLO_WORLD 12",
   "why": "the capitals; everything else as it is"
  },
  {
   "id": "names/fold/accents",
   "op": "fold",
   "in": {
    "text": "caf\u00e9 \u00c9t\u00e9"
   },
   "out": "CAF\u00c9 \u00c9T\u00c9",
   "why": "a letter with an accent folds to its capital"
  },
  {
   "id": "names/fold/sharp-s-stays",
   "op": "fold",
   "in": {
    "text": "stra\u00dfe"
   },
   "out": "STRA\u00dfE",
   "why": "one code point to one: its capital is two letters, so it keeps itself"
  },
  {
   "id": "names/fold/dotless-i-has-no-bridge",
   "op": "fold",
   "in": {
    "text": "\u0131"
   },
   "out": "\u0131",
   "why": "no code point beyond ASCII becomes an ASCII letter: the dotless i stays"
  },
  {
   "id": "names/fold/dotted-capital-i-has-no-bridge",
   "op": "fold",
   "in": {
    "text": "\u0130i"
   },
   "out": "\u0130I",
   "why": "the dotted capital I stays; the ASCII i folds to I"
  },
  {
   "id": "names/fold/long-s-has-no-bridge",
   "op": "fold",
   "in": {
    "text": "\u017f"
   },
   "out": "\u017f",
   "why": "the long s is not an s"
  },
  {
   "id": "names/fold/kelvin-has-no-bridge",
   "op": "fold",
   "in": {
    "text": "\u212a"
   },
   "out": "\u212a",
   "why": "the Kelvin sign is not a k, and has no capital"
  },
  {
   "id": "names/fold/digraph-takes-its-simple-capital",
   "op": "fold",
   "in": {
    "text": "\u01c6"
   },
   "out": "\u01c4",
   "why": "the simple upper case, not the title case"
  },
  {
   "id": "names/fold/greek-final-sigma",
   "op": "fold",
   "in": {
    "text": "\u03c2"
   },
   "out": "\u03a3",
   "why": "final sigma has the same capital as sigma"
  },
  {
   "id": "names/fold/georgian",
   "op": "fold",
   "in": {
    "text": "\u10d0\u10d1"
   },
   "out": "\u1c90\u1c91",
   "why": "Georgian small letters fold to the Mtavruli capitals"
  },
  {
   "id": "names/fold/cherokee",
   "op": "fold",
   "in": {
    "text": "\uab70"
   },
   "out": "\u13a0",
   "why": "Cherokee small letters fold to the capitals"
  },
  {
   "id": "names/fold/deseret-beyond-the-plane",
   "op": "fold",
   "in": {
    "text": "\ud801\udc28"
   },
   "out": "\ud801\udc00",
   "why": "a pair of surrogates folds as ONE code point"
  },
  {
   "id": "names/fold/a-letter-the-runtime-may-not-know",
   "op": "fold",
   "in": {
    "text": "\ua7cd"
   },
   "out": "\ua7cc",
   "why": "Latin Extended-D, Unicode 16: the table is the project's, whatever the runtime"
  },
  {
   "id": "names/fold/empty",
   "op": "fold",
   "in": {
    "text": ""
   },
   "out": "",
   "why": "nothing in, nothing out"
  },
