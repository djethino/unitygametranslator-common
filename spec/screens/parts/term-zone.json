{
  "$comment": "The term zone: a term's word and its written forms, beside the sentence that cites it — to the RIGHT of it. A part: one template, 'Zone', that TermZone instantiates into the host an editing screen leaves for it (TermHost), and 'FormEditRow', one row for each form. EDITABLE: what it writes is TermEdit's (the draft, the problems before the click, the effect before Apply); what each line says is decided in code. Its words are the site's (spec/wording.json).",
  "name": "TermZone",
  "part": true,
  "templates": [
    { "kind": "stack", "name": "Zone", "spacing": "ElementSpacing", "pad": "SectionPadding", "surface": "Card", "children": [
      { "kind": "label", "name": "ZoneTitle", "text": "Term", "role": "SectionTitle", "fill": "Stretch" },
      { "kind": "label", "name": "KeyCaption", "text": "Source term", "role": "Caption", "tone": "Secondary" },
      { "kind": "label", "name": "ZoneKey", "gameText": "source", "text": { "bind": "zoneKey" }, "policy": "Excluded", "fill": "Stretch", "autoHeight": true },
      { "kind": "label", "name": "WordCaption", "text": "Translation", "role": "Caption", "tone": "Secondary" },
      { "kind": "row", "name": "WordRow", "spacing": 4, "pad": 0, "fill": "Stretch", "minHeight": "RowHeightNormal", "children": [
        { "kind": "field", "name": "WordInput", "gameText": "target", "placeholder": "Enter translation...", "richText": false, "fill": "Stretch", "minHeight": "RowHeightNormal" },
        { "kind": "button", "name": "TranslateBtn", "text": "Retranslate (AI)", "size": "Compact", "minWidth": 110, "policy": "Excluded", "act": "translateWord", "visible": false,
          "help": "Re-translate with the game's AI" }
      ] },
      { "kind": "label", "name": "TranslateReason", "text": { "bind": "translateReason" }, "policy": "Excluded", "role": "Small", "tone": "Secondary", "fill": "Stretch", "autoHeight": true, "visible": false },
      { "kind": "label", "name": "WordProblems", "text": { "bind": "wordProblems" }, "policy": "Excluded", "role": "Small", "tone": "Error", "richText": false, "fill": "Stretch", "autoHeight": true, "visible": false },
      { "kind": "label", "name": "FormsCaption", "text": "Forms", "role": "Caption", "tone": "Secondary" },
      { "kind": "stack", "name": "FormsHost", "spacing": 4 },
      { "kind": "button", "name": "AddFormBtn", "text": "Add form", "size": "Compact", "minWidth": 90, "act": "addForm" },
      { "kind": "label", "name": "UsedCaption", "text": "Used in", "role": "Caption", "tone": "Secondary" },
      { "kind": "label", "name": "ZoneUsed", "text": { "bind": "zoneUsed" }, "policy": "Excluded", "role": "Small", "fill": "Stretch", "autoHeight": true },
      { "kind": "label", "name": "TextsLine", "text": { "bind": "textsLine" }, "policy": "Excluded", "role": "Small", "tone": "Plain", "fill": "Stretch", "autoHeight": true, "visible": false },
      { "kind": "label", "name": "ReviewLine", "text": { "bind": "reviewLine" }, "policy": "Excluded", "role": "Small", "tone": "Info", "fill": "Stretch", "autoHeight": true, "visible": false },
      { "kind": "label", "name": "ZoneProblem", "text": { "bind": "zoneProblem" }, "policy": "Excluded", "role": "Small", "tone": "Error", "richText": false, "fill": "Stretch", "autoHeight": true, "visible": false },
      { "kind": "label", "name": "ZoneGone", "text": "This term no longer exists.", "role": "Small", "tone": "Warning", "visible": false },
      { "kind": "label", "name": "WaitingLine", "text": { "bind": "waitingLine" }, "policy": "Excluded", "role": "Small", "tone": "Warning", "fill": "Stretch", "autoHeight": true, "visible": false },
      { "kind": "row", "name": "ZoneButtons", "spacing": "SmallSpacing", "pad": 0, "minHeight": "RowHeightNormal", "placement": "MiddleRight", "children": [
        { "kind": "button", "name": "CancelBtn", "text": "Cancel", "size": "Compact", "minWidth": 80, "act": "closeTerm" },
        { "kind": "button", "name": "ApplyBtn", "text": "Apply", "tone": "Primary", "size": "Compact", "minWidth": 100, "act": "applyTerm" }
      ] }
    ] },
    { "kind": "stack", "name": "FormEditRow", "spacing": 2, "pad": 0, "fill": "Stretch", "children": [
      { "kind": "row", "name": "FormLine", "spacing": 6, "pad": 0, "minHeight": "RowHeightNormal", "children": [
        { "kind": "label", "name": "FormId", "text": { "bind": "formId" }, "policy": "Excluded", "role": "Caption", "tone": "Muted", "minWidth": 30 },
        { "kind": "field", "name": "FormInput", "gameText": "target", "richText": false, "fill": "Stretch", "minHeight": "RowHeightNormal" },
        { "kind": "button", "name": "RemoveBtn", "text": "Remove", "size": "Compact", "minWidth": 70, "act": "removeForm" }
      ] },
      { "kind": "label", "name": "FormNote", "text": { "bind": "formNote" }, "policy": "Excluded", "role": "Small", "tone": "Plain", "richText": false, "fill": "Stretch", "autoHeight": true, "visible": false }
    ] }
  ]
}
